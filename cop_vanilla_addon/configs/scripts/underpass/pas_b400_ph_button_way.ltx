[logic]
active = ph_button@wait

[ph_button@wait] 
anim = idle
on_press = ph_idle@sound %=anim_obj_forward(pas_b400_door_way) +pas_b400_way_button_pressed -pas_b400_about_gates%
tooltip = tip_door_open

[ph_idle@sound]
on_game_timer = 70 | ph_idle@nil %+pas_b400_way_door_opened%
on_info = {-jup_b217_actor_want_solo -pas_b400_ph_button_way_stalkers_squad_heal} %=heal_squad(pas_b400_stalkers_squad) +pas_b400_ph_button_way_stalkers_squad_heal%

[ph_idle@nil]
