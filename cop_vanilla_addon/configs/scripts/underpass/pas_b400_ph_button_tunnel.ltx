[logic]
active = ph_button@wait

[ph_button@wait] 
anim = idle
on_press = ph_idle@wreck %=anim_obj_forward(pas_b400_door_tunnel) +pas_b400_tunnel_button_pressed%
tooltip = tip_door_open

[ph_idle@wreck]
on_game_timer =  60 | ph_idle@field_off %+pas_b400_tunnel_gates_started_to_open% 
on_info = {-jup_b217_actor_want_solo -pas_b400_ph_button_tunnel_stalkers_squad_heal} %=heal_squad(pas_b400_stalkers_squad) +pas_b400_ph_button_tunnel_stalkers_squad_heal%

[ph_idle@field_off]
on_game_timer = 190 | ph_idle@nil %+pas_b400_field_tunnel_off%

[ph_idle@nil]
