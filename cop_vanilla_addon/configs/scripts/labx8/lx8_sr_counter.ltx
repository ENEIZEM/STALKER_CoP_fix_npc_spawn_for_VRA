[logic]
active = sr_idle@quest

[sr_idle@quest]
on_actor_in_zone = labx8_sr_quest | sr_idle@one %=set_counter(lx8_documents)%


[sr_idle@one]
on_info = {=counter_equal(lx8_documents:1)} %+lx8_doc_founded_1%
on_info2 = {=counter_equal(lx8_documents:2)} %+lx8_doc_founded_2%
on_info3 = {=counter_equal(lx8_documents:3)} %+lx8_doc_founded_3%
on_info4 = {=counter_equal(lx8_documents:4)} %+lx8_doc_founded_4%
on_info5 = {=counter_equal(lx8_documents:5)} %+lx8_doc_founded_5%
on_info6 = {=counter_equal(lx8_documents:6)} sr_idle@controller %+lx8_doc_founded_6 =anim_obj_backward(lx8_physic_door) =create_squad(lx8_controller_squad:lx8_smart_terrain)%

[sr_idle@six]
on_info = {=counter_equal(lx8_documents:6)} sr_idle@controller %+lx8_doc_founded_6 =anim_obj_backward(lx8_physic_door) =create_squad(lx8_controller_squad:lx8_smart_terrain)%

[sr_idle@controller]
on_info = {+lx8_controller_dead} sr_idle@nil %=anim_obj_forward(lx8_physic_door)%

[sr_idle@nil]