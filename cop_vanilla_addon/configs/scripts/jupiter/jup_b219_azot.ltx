[logic@jup_b219_azot]
suitable = {=check_npc_name(jup_b219_stalker_tech)}
active = walker@sig
prior = 200

[walker@sig]
path_walk = azot_walk
path_look = azot_look
on_signal = azot | {-jup_b219_azot_on_pos} %+jup_b219_azot_on_pos%
def_state_standing = wait_na
def_state_moving = walk
combat_ignore_keep_when_attacked = true 
combat_ignore_cond = true
meet = no_meet
invulnerable = true
out_restr = jup_factory_default_in_restrictor
danger = danger
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false

;Better cause we're play clear animation without Nitro jerk-self 
on_info  = {+jup_b219_azot_on_pos +jup_b219_start_actor_one} 			animpoint@start_actor_solo
on_info2 = {+jup_b219_azot_on_pos +jup_b219_start_one} 					animpoint@start_one
on_info3 = {+jup_b219_azot_on_pos +jup_b219_start_one_vano} 			animpoint@start_one_vano
on_info4 = {+jup_b219_azot_on_pos +jup_b219_start_one_monolith} 		animpoint@start_one_monolith
on_info5 = {+jup_b219_azot_on_pos +jup_b219_start_one_soldier} 			animpoint@start_one_soldier
on_info6 = {+jup_b219_azot_on_pos +jup_b219_start_all} 					animpoint@start_all
on_info7 = {+jup_b219_azot_on_pos +jup_b219_start_soldier_vano} 		animpoint@start_soldier_vano
on_info8 = {+jup_b219_azot_on_pos +jup_b219_start_soldier_monolith} 	animpoint@start_soldier_monolith
on_info9 = {+jup_b219_azot_on_pos +jup_b219_start_vano_monolith} 		animpoint@start_vano_monolith

[animpoint@azot]
cover_name = jup_b219_azot_smart_cover
combat_ignore_cond = true
use_camp = false
reach_distance = 50
meet = no_meet
reach_movement = walk
combat_ignore_cond = true
combat_ignore_keep_when_attacked = true
invulnerable = true
out_restr = jup_factory_default_in_restrictor
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false

[animpoint@start_actor_solo]:animpoint@azot
avail_animations = jup_b219_azot_actor_solo
on_game_timer = 50 | %=play_sound(jup_b219_tech_smash_metal_1) +jup_b219_tech_smash_metal_1%

[animpoint@start_one]:animpoint@azot
avail_animations = jup_b219_azot_one
on_game_timer = 50 | %=play_sound(jup_b219_tech_smash_metal_1) +jup_b219_tech_smash_metal_1%

[animpoint@start_one_vano]:animpoint@azot
avail_animations = jup_b219_azot_one_vano
on_game_timer = 50 | %=play_sound(jup_b219_tech_smash_metal_1) +jup_b219_tech_smash_metal_1%

[animpoint@start_one_monolith]:animpoint@azot
