on_game_timer = 50 | %=play_sound(jup_b219_tech_smash_metal_1) +jup_b219_tech_smash_metal_1%

[animpoint@start_soldier_monolith]:animpoint@azot
avail_animations = jup_b219_azot_soldier_monolith
on_game_timer = 50 | %=play_sound(jup_b219_tech_smash_metal_1) +jup_b219_tech_smash_metal_1%

