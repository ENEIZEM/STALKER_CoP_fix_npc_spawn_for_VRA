[logic]
active = sr_idle@actor_choice

[sr_idle@actor_choice]
on_info = {+jup_a6_gonta_jupiter -jup_b6_gonta_employed} sr_idle@spawn_escort_cutscene %+jup_b217_actor_can_solo% 
on_info2 = {+jup_a12_task_done +jup_a12_stalker_prisoner_helped} sr_idle@spawn_escort_cutscene %+jup_b217_actor_can_solo%
on_info3 = {+sim_duty_help_harder} sr_idle@spawn_escort_cutscene %+jup_b217_actor_can_solo%
on_info4 = {+sim_freedom_help_harder} sr_idle@spawn_escort_cutscene %+jup_b217_actor_can_solo%
on_info5 = {+jup_b217_actor_want_group} sr_idle@wait_for_start

[sr_idle@spawn_escort_cutscene]
on_info = {+jup_b218_gather_squad_complete +jup_b218_nitro_guards_gonta_group_talk =squad_exist(jup_a6_stalker_gonta_squad)} sr_idle@wait_for_start %=teleport_squad(jup_a6_stalker_gonta_squad:jup_b219_zulus_walk) +jup_a6_stalker_gonta_squad_teleported%
on_info2 = {+jup_b218_gather_squad_complete +jup_b218_nitro_guards_bear_group_talk =squad_exist(jup_a12_stalker_squad) =squad_exist(jup_a12_prisoner)} sr_idle@wait_for_start %=teleport_squad(jup_a12_stalker_squad:jup_b219_zulus_walk) =teleport_squad(jup_a12_prisoner:jup_b219_zulus_look) +jup_a12_stalker_squad_teleported%
on_info3 = {+jup_b218_gather_squad_complete +jup_b218_nitro_guards_duty_group_talk} sr_idle@wait_for_start %=create_squad(duty_escort_nitro_squad:jup_b219) +duty_escort_nitro_squad_spawned%
on_info4 = {+jup_b218_gather_squad_complete +jup_b218_nitro_guards_freedom_group_talk} sr_idle@wait_for_start %=create_squad(freedom_escort_nitro_squad:jup_b219) +freedom_escort_nitro_squad_spawned%
on_info5 = {+jup_b217_actor_want_group} sr_idle@wait_for_start

[sr_idle@wait_for_start]
on_info = {+jup_b218_gather_squad_complete} sr_idle@destroy %=create_cutscene_actor_with_weapon(jup_b219_actor:jup_b219_spawn_spown:0:0:3) =run_postprocess(fade_in) =disable_ui%  ;=run_postprocess(fade_in) =disable_ui 

[sr_idle@destroy]
on_game_timer = 30 | sr_idle@surge %=teleport_actor(jup_b219_actor_dark_walk:jup_b219_actor_dark_look)  =run_postprocess(black:22219:true)% ;=run_postprocess(black:22219:true)  =forward_game_time(3)

[sr_idle@surge]
on_info = {!surge_started} sr_idle@timer, sr_idle@timer %=stop_surge%

[sr_idle@timer]
on_info = {-jup_b217_actor_want_solo} sr_idle@spawn %=remove_squad(jup_b15_zulus_squad)% 
on_info2 = {+jup_b217_actor_want_solo} sr_idle@spawn

[sr_idle@spawn]
on_info = {-jup_b217_actor_want_solo} sr_idle@spawn_soldier %=create_squad(jup_b219_squad:jup_b219) =create_squad(jup_b219_stalker_tech_squad:jup_b219)%
on_info2 = {+jup_b217_actor_want_solo} sr_idle@cheak  %=create_squad(jup_b219_stalker_tech_squad:jup_b219) %

[sr_idle@spawn_soldier]
on_info = {+jup_b218_soldier_hired} sr_idle@spawn_stalker %=create_squad_member(jup_b219_soldier:jup_b219_squad:jup_b219_soldier_walk)%
on_info2 = {-jup_b218_soldier_hired} sr_idle@spawn_stalker

[sr_idle@spawn_stalker]
on_info = {+jup_a10_vano_agree_go_und} sr_idle@spawn_monolith %=create_squad_member(jup_b219_vano:jup_b219_squad:jup_b219_vano_walk)%
on_info2 = {-jup_a10_vano_agree_go_und} sr_idle@spawn_monolith

[sr_idle@spawn_monolith]
on_info = {+jup_b218_monolith_hired} sr_idle@cheak %=create_squad_member(jup_b219_monolith_squad_leader_freedom_skin:jup_b219_squad:jup_b219_monolith_walk)% 
on_info2 = {-jup_b218_monolith_hired} sr_idle@cheak 
  
[sr_idle@cheak]
on_info = {-jup_b217_actor_want_solo -jup_b218_soldier_hired -jup_a10_vano_agree_go_und -jup_b218_monolith_hired}  sr_idle@wait_squad_one             	
on_info2 = {-jup_b217_actor_want_solo -jup_b218_soldier_hired +jup_a10_vano_agree_go_und -jup_b218_monolith_hired} sr_idle@wait_squad_one_vano   			
on_info3 = {-jup_b217_actor_want_solo -jup_b218_soldier_hired -jup_a10_vano_agree_go_und +jup_b218_monolith_hired} sr_idle@wait_squad_one_monolith   		
on_info4 = {-jup_b217_actor_want_solo +jup_b218_soldier_hired -jup_a10_vano_agree_go_und -jup_b218_monolith_hired} sr_idle@wait_squad_one_soldier   		
on_info5 = {-jup_b217_actor_want_solo +jup_b218_soldier_hired +jup_a10_vano_agree_go_und +jup_b218_monolith_hired} sr_idle@wait_squad_all   				
on_info6 = {-jup_b217_actor_want_solo +jup_b218_soldier_hired +jup_a10_vano_agree_go_und -jup_b218_monolith_hired} sr_idle@wait_squad_soldier_vano   		
on_info7 = {-jup_b217_actor_want_solo +jup_b218_soldier_hired -jup_a10_vano_agree_go_und +jup_b218_monolith_hired} sr_idle@wait_squad_soldier_monolith   	  
on_info8 = {-jup_b217_actor_want_solo -jup_b218_soldier_hired +jup_a10_vano_agree_go_und +jup_b218_monolith_hired} sr_idle@wait_squad_vano_monolith   	   
on_info9 = {+jup_b217_actor_want_solo} sr_idle@wait_actor_one     
  
[sr_idle@wait_actor_one]   
on_info = {+jup_b219_azot_on_pos +jup_b219_actor_on_pos} sr_cutscene@start %+jup_b219_start_actor_one +jup_b219_start_sound =stop_postprocess(22219)%
  
[sr_idle@wait_squad_one]   
on_info = {+jup_b219_azot_on_pos +jup_b219_zulus_on_pos +jup_b219_actor_on_pos}  sr_cutscene@start %+jup_b219_start_one +jup_b219_start_sound =stop_postprocess(22219)%
  
[sr_idle@wait_squad_one_vano]   
on_info = {+jup_b219_azot_on_pos +jup_b219_zulus_on_pos +jup_b219_actor_on_pos +jup_b219_vano_on_pos}  sr_cutscene@start %+jup_b219_start_one_vano +jup_b219_start_sound =stop_postprocess(22219)%

[sr_idle@wait_squad_one_monolith]   
on_info = {+jup_b219_azot_on_pos +jup_b219_zulus_on_pos +jup_b219_actor_on_pos +jup_b219_monolith_on_pos}  sr_cutscene@start %+jup_b219_start_one_monolith +jup_b219_start_sound =stop_postprocess(22219)%

[sr_idle@wait_squad_one_soldier]   
on_info = {+jup_b219_azot_on_pos +jup_b219_zulus_on_pos +jup_b219_actor_on_pos +jup_b219_soldier_on_pos}  sr_cutscene@start %+jup_b219_start_one_soldier +jup_b219_start_sound =stop_postprocess(22219)%

[sr_idle@wait_squad_all]   
on_info = {+jup_b219_azot_on_pos +jup_b219_zulus_on_pos +jup_b219_actor_on_pos +jup_b219_soldier_on_pos +jup_b219_monolith_on_pos +jup_b219_vano_on_pos}  sr_cutscene@start %+jup_b219_start_all +jup_b219_start_sound =stop_postprocess(22219)%
   
[sr_idle@wait_squad_soldier_vano]   
on_info = {+jup_b219_azot_on_pos +jup_b219_zulus_on_pos +jup_b219_actor_on_pos +jup_b219_soldier_on_pos +jup_b219_vano_on_pos}  sr_cutscene@start %+jup_b219_start_soldier_vano +jup_b219_start_sound =stop_postprocess(22219)%   
   
[sr_idle@wait_squad_soldier_monolith]   
on_info = {+jup_b219_azot_on_pos +jup_b219_zulus_on_pos +jup_b219_actor_on_pos +jup_b219_soldier_on_pos +jup_b219_monolith_on_pos}  sr_cutscene@start %+jup_b219_start_soldier_monolith +jup_b219_start_sound =stop_postprocess(22219)%    
   
[sr_idle@wait_squad_vano_monolith]   
on_info = {+jup_b219_azot_on_pos +jup_b219_zulus_on_pos +jup_b219_actor_on_pos +jup_b219_vano_on_pos +jup_b219_monolith_on_pos}  sr_cutscene@start %+jup_b219_start_vano_monolith +jup_b219_start_sound =stop_postprocess(22219)%    
   
[sr_cutscene@start]
point = jup_b219_actor_start_walk
look = jup_b219_actor_start_look
cam_effector = jup_b219_descent_camera
on_signal = cameff_end | sr_idle@go_to_lc_wait %+jup_b219_fade_in =run_postprocess(black:22219:true)% 
enable_ui_on_end = false   
on_info = {+jup_b219_entering_underpass} %=run_postprocess(fade_in)%
   
[sr_idle@go_to_lc_wait]
on_info = {-jup_b217_actor_want_solo} sr_idle@go_to_lc
on_info2 = {+jup_b217_actor_want_solo} sr_idle@go_to_lc_solo

[sr_idle@go_to_lc]
on_info =  {-jup_b219_fade_in} %+jup_b219_fade_in =run_postprocess(black:22219:true)%
on_game_timer = 30 | sr_idle@nil %+jup_b219_destroy_actor =teleport_actor(jup_b219_actor_levelchanger_walk:jup_b219_actor_levelchanger_look) =remove_squad(jup_b219_squad) =remove_squad(jup_b219_stalker_tech_squad)% 

[sr_idle@go_to_lc_solo]
on_info = {-jup_b219_fade_in} %+jup_b219_fade_in =run_postprocess(black:22219:true)%
on_info2 = sr_idle@go_to_lc_solo_escort_teleport

[sr_idle@go_to_lc_solo_escort_teleport]
on_info = {+jup_a6_stalker_gonta_squad_teleported -jup_a6_stalker_gonta_squad_teleported_home =squad_exist(jup_a6_stalker_gonta_squad)} %=teleport_squad(jup_a6_stalker_gonta_squad:jup_a6_spawn_point) +jup_a6_stalker_gonta_squad_teleported_home%
on_info2 = {+jup_a12_stalker_squad_teleported -jup_a12_stalker_squad_teleported_home =squad_exist(jup_a12_stalker_squad)} %=teleport_squad(jup_a12_stalker_squad:jup_a6_spawn_point) =teleport_squad(jup_a12_prisoner:jup_a6_spawn_point) +jup_a12_stalker_squad_teleported_home%
on_info3 = {+duty_escort_nitro_squad_spawned =squad_exist(duty_escort_nitro_squad)} %=remove_squad(duty_escort_nitro_squad)%
on_info4 = {+freedom_escort_nitro_squad_spawned =squad_exist(freedom_escort_nitro_squad)} %=remove_squad(freedom_escort_nitro_squad)%
on_game_timer = 30 | sr_idle@nil %+jup_b219_destroy_actor =teleport_actor(jup_b219_actor_levelchanger_walk:jup_b219_actor_levelchanger_look) =remove_squad(jup_b219_stalker_tech_squad)% 

[sr_idle@nil]