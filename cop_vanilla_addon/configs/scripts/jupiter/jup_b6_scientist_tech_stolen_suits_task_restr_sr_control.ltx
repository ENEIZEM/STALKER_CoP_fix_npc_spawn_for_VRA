[logic]
active = sr_idle@start

[sr_idle@start]
on_info = {=distance_to_obj_ge(jup_a6_smart_id:100) +jup_b6_scientist_tech_stolen_suits_task_start} sr_idle@wait %=clear_smart_radius(jup_b206:250) =clear_smart_radius(jup_sim_15:250) =remove_squad(jup_b41_artefact_hunter_squad) =create_squad(jup_b41_artefact_hunter_ecolog_squad:jup_b206) =create_squad(jup_b206_artefact_hunters_arrest_squad:jup_b206)%

[sr_idle@wait]
on_info = {+jup_a6_arrest_leader_stolen_suits_task_talk} sr_idle@wait_2

[sr_idle@wait_2]
on_info = {+jup_b6_scientist_tech_stolen_suits_task_end} sr_idle@teleport
on_game_timer = 3600 | sr_idle@teleport %+jup_b6_scientist_tech_stolen_suits_task_waste_time%

[sr_idle@teleport]
on_info = {=distance_to_obj_ge(jup_a6_smart_id:75) =distance_to_obj_ge(jup_b206_spot:75) -jup_b6_scientist_tech_stolen_suits_task_wait_squads_go_base} %=teleport_squad(jup_b41_artefact_hunter_ecolog_squad:jup_a6_actor_look) +jup_b6_scientist_tech_stolen_suits_task_wait_squads_go_base%
on_info2 = {=squad_exist(jup_b206_artefact_hunters_arrest_squad) =distance_to_obj_ge(jup_b206_spot:85)} %=remove_squad(jup_b206_artefact_hunters_arrest_squad) +jup_b206_artefact_hunters_arrest_squad_remove%
on_info3 = {!squad_exist(jup_b206_artefact_hunters_arrest_squad) -jup_b206_artefact_hunters_arrest_squad_remove} %+jup_b206_artefact_hunters_arrest_squad_remove%
on_info5 = {+jup_b6_scientist_tech_stolen_suits_task_wait_squads_go_base +jup_b206_artefact_hunters_arrest_squad} sr_idle@wait_for_sell

[sr_idle@wait_for_sell]
on_game_timer = 7200 | sr_idle@end %+jup_b6_scientist_tech_can_buy_stolen_suit_by_actor%

[sr_idle@end]