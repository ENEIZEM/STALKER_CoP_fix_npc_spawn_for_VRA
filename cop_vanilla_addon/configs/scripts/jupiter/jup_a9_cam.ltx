[logic]
active = sr_idle@destroy

[sr_idle@destroy]
on_info = sr_idle@select %=destroy_object(story:jup_a9_way_info_fake) =destroy_object(story:jup_a9_conservation_info_fake) =destroy_object(story:jup_a9_power_info_fake)%

[sr_idle@select]
on_info1 = {=actor_in_zone(jup_a9_cam_1) =actor_has_item(jup_a9_way_info) -jup_a9_way_info} %=play_sound(jup_a9_actor_way_info) +jup_a9_way_info%
on_info2 = {=actor_in_zone(jup_a9_cam_2) =actor_has_item(jup_a9_conservation_info) -jup_a9_conservation_info} %=play_sound(jup_a9_actor_conservation_info) +jup_a9_conservation_info%
on_info3 = {=actor_in_zone(jup_a9_cam_3) =actor_has_item(jup_a9_power_info) -jup_a9_power_info} %=play_sound(jup_a9_actor_power_info) +jup_a9_power_info% 
on_info4 = {+jup_a9_way_info +jup_a9_conservation_info +jup_a9_power_info} sr_idle@end

;end

[sr_idle@end]
on_info = {-jup_a9_scenari_save_after_three_docs} %+jup_a9_scenari_save_after_three_docs =scenario_autosave(st_save_jup_a9_got_underpass_docs)%
on_info2 = {+jup_a9_scenari_save_after_three_docs} sr_idle@nil

[sr_idle@nil]
