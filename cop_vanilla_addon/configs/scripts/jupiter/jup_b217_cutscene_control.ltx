[logic] 
active = sr_idle@jup_b217_welcome_cameff_begin

[sr_idle@jup_b217_welcome_cameff_begin]
on_info = {+jup_b217_welcome_faded} sr_idle@jup_b217_give_task

; Not use 
[sr_cutscene@217]
point = jup_a6_actor_walk
look  = jup_a6_actor_look
on_game_timer = 25 | {-jup_b217_pp_end_in_scene} %+jup_b217_pp_end_in_scene%
cam_effector = scenario_cam\jupiter\jup_b217_welcome_cameff
enable_ui_on_end = true
global_cameffect = true
on_info = {+jup_b217_welcome_tech_talked} %=stop_sr_cutscene =run_postprocess(fade_in_out)%
on_signal = cameff_end | sr_idle@jup_b217_give_task 

[sr_idle@jup_b217_give_task]
on_info = {-jup_b217_arrived_to_jup_saved} %+jup_b217_arrived_to_jup_saved =scenario_autosave(st_save_jup_b217_arrived_to_jup)%
on_info2 = {+jup_b217_tech_instruments_start} sr_idle@wait %=give_task(jup_b217_tech_instruments)%

[sr_idle@wait]
on_info = {-jup_a6_tasks_done +jup_b4_task_end +jup_b46_task_done +jup_b207_task_end} %+jup_a6_tasks_done%
on_info3 = sr_idle@nil

[sr_idle@clean_up_gonta]
on_info = {+zat_b106_garmata_dead} sr_idle@wait %=remove_npc(jup_b6_stalker_garmata)%

[sr_idle@nil]


