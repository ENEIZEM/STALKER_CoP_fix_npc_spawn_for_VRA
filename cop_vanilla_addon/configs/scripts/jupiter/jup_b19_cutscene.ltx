[logic]
active = sr_idle

[sr_idle]
on_info = {+jup_b19_merc_spawned} sr_cutscene@cam1  %=disable_ui%
on_info2 = {+jup_b19_fail} sr_idle@nil

[sr_cutscene@cam1]
point = jup_b19_merc4_10_walk
look = jup_b19_merc1_4_look
cam_effector = scenario_cam\Jupiter\jup_b19_waiting_for_mercs
on_signal = cameff_end | sr_idle@yar_teleport
global_cameffect = true
enable_ui_on_end = true  
outdoor = true
on_info = {+jup_b19_fight_begun} %=stop_sr_cutscene%

[sr_idle@yar_teleport]
on_info = {-jup_b19_yar_switch_smart_terrain =distance_to_obj_ge(jup_b19_freedom_yar:70) !squad_exist(jup_b19_merc_squad) -jup_b19_actor_damaged_zombied -jup_b19_dont_break} sr_idle@nil %=teleport_npc_by_story_id(jup_b19_freedom_yar:jup_a6_actor_walk) +jup_b19_yar_switch_smart_terrain%
on_info2 = {-jup_b19_yar_switch_smart_terrain =distance_to_obj_ge(jup_b19_freedom_yar:70) +jup_b19_kopatci_zombied_squad_dead +jup_b19_actor_damaged_zombied -jup_b19_dont_break} sr_idle@nil %=teleport_npc_by_story_id(jup_b19_freedom_yar:jup_a6_actor_walk) +jup_b19_yar_switch_smart_terrain%
on_info3 = {+jup_b19_yar_switch_smart_terrain} sr_idle@nil

[sr_idle@nil]