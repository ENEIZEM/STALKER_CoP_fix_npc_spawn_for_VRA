[logic]
active = sr_idle@sound

[sr_idle@sound]
on_info = {-lights_alarm_1_cycle_done} sr_idle@wait_nitro %=play_sound(jup_b219_lamp_alarm_squeak)%

[sr_idle@wait_nitro]
on_info = %=play_sound(jup_b219_lamp_alarm_squeak)%
on_info2 = {+jup_b219_tech_smash_metal_1} sr_idle@off_first

[sr_idle@off_first]
on_game_timer = 2 | sr_idle@on_first %=turn_off(lights_alarm_1)% 

[sr_idle@on_first]
on_game_timer = 5 | sr_idle@off_second %=turn_on(lights_alarm_1) =play_sound(jup_b219_lamp_alarm_squeak)%

[sr_idle@off_second]
on_game_timer = 2 | sr_idle@on_second %=turn_off(lights_alarm_1)%

[sr_idle@on_second]
on_game_timer = 5 | sr_idle@sound %=turn_on(lights_alarm_1) =play_sound(jup_b219_lamp_alarm_squeak) +lights_alarm_1_cycle_done%

[sr_idle@nil]