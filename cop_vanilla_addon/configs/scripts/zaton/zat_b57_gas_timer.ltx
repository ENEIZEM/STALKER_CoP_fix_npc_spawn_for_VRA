[logic]
active = sr_idle@wait

[sr_idle@wait]
on_info = {+zat_b57_den_of_the_bloodsucker_wait_destroy_give} sr_timer@gas

[sr_timer@gas]
type = dec
start_value = 60 ; реальные секунды
on_value = 0 | sr_idle@nil %+zat_b57_gas_running_stop +zat_b57_den_of_the_bloodsucker_tell_stalkers_about_destroy_lair_give%
timer_pause = {+vintil_gas_running_clipped} true, false 
on_info = {=distance_to_obj_ge(zat_b57_place_gas_id:200)} sr_idle@nil %+zat_b38_den_of_the_bloodsucker_actor_gone%

[sr_idle@nil]