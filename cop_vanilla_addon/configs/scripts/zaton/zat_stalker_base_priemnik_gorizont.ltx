[logic]
active = ph_idle@off

[ph_idle@on]
on_info = %=play_sound(zat_stalker_base_radio_priemnik_gorizont)%
on_info2 = {=surge_started} ph_idle@surge %=stop_sound%
on_use = ph_idle@off %=stop_sound%
tips = switch_radio_butt_off
hit_on_bone = 1 | ph_idle@broken |2| ph_idle@broken |3| ph_idle@broken |4| ph_idle@broken

[ph_idle@off]
on_use = ph_idle@on
tips = switch_radio_butt_on
hit_on_bone = 1 | ph_idle@broken |2| ph_idle@broken |3| ph_idle@broken |4| ph_idle@broken

[ph_idle@surge]
on_use = ph_idle@off %=stop_sound_looped%
tips = switch_radio_butt_off
on_info = %=play_sound_looped(broken_noise_radio)%
on_info2 = {!surge_started} ph_idle@on %=stop_sound_looped%
hit_on_bone = 1 | ph_idle@broken |2| ph_idle@broken |3| ph_idle@broken |4| ph_idle@broken

[ph_idle@broken]
on_info = nil %=stop_sound_looped%