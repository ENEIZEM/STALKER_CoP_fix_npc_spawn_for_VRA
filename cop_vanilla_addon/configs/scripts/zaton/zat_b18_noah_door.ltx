[logic]
active = ph_door@close

[ph_door@close]
locked = false
closed = true
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
-- Фикс: Если квест провален, дверь вылетает в свободный режим
on_info = {+zat_noah_help_task_fail -zat_b18_door_unlocked} ph_door@free %+zat_b18_door_unlocked%
on_info2 = {+zat_b18_reset_memory} %-zat_b18_noah_shot_door -zat_b18_noah_remembers -zat_b18_reset_memory -zat_b18_door_open%
on_info3 = {-zat_b18_dog_close} %+zat_b18_dog_close -zat_b18_dog_open%
on_info4 = {+zat_b18_dog_noah_free -zat_b18_dog_noah_free_door} ph_door@open %+zat_b18_dog_noah_free_door%
-- Если первый раз (нет поршня shot_door) - выбиваем в free. Если уже был выстрел - просто открываем.
on_use = {-zat_b18_noah_shot_door -zat_b18_door_open} ph_door@free %+zat_b18_noah_shot_door +zat_b18_door_open%, ph_door@open

[ph_door@open]
locked = false
closed = false
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_use = ph_door@close %-zat_b18_noah_shot_door%
on_info = {+zat_noah_help_task_fail -zat_b18_door_unlocked} ph_door@free %+zat_b18_door_unlocked%
on_info2 = {+zat_b18_reset_memory} ph_door@close %-zat_b18_noah_shot_door -zat_b18_noah_remembers -zat_b18_door_open%
on_info3 = {-zat_b18_dog_open} %+zat_b18_dog_open -zat_b18_dog_close%

[ph_door@free]
locked = false
closed = false
no_force = true
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
-- Клик по выбитой двери закрывает её (логично возвращаем "мотор" двери)
on_use = ph_door@close %+zat_b18_door_unlocked%
on_info = {+zat_b18_reset_memory} ph_door@close %-zat_b18_noah_shot_door -zat_b18_noah_remembers -zat_b18_door_open%
on_info2 = {-zat_b18_dog_open} %+zat_b18_dog_open -zat_b18_dog_close%
on_info3 = {+zat_b18_dog_noah_free -zat_b18_dog_noah_free_door} ph_door@open %+zat_b18_dog_noah_free_door%