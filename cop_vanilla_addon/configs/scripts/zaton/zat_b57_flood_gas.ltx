[logic]
active = sr_idle@enable

[sr_idle@enable]
on_info = {+zat_b57_gas_running_play} sr_particle@flood

[sr_particle@flood]
name = vehiclefx\effects\skid_asphalt_start ;skid_asphalt_stop
path = zat_b57_place_gas_point
mode = 2
looped = true
on_info = {+vintil_gas_running_clipped} sr_idle@stop
on_info2 = {+zat_b57_gas_running_stop} sr_idle@nil
on_info3 = {+zat_b38_den_of_the_bloodsucker_actor_gone} sr_idle@nil

[sr_idle@stop]
on_info = {-vintil_gas_running_clipped} sr_particle@flood
on_info2 = {+zat_b57_gas_running_stop} sr_idle@nil
on_info3 = {+zat_b38_den_of_the_bloodsucker_actor_gone} sr_idle@nil

[sr_idle@nil]