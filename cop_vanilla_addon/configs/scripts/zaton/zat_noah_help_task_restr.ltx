[logic]
active = sr_idle@start_attack

[sr_idle@start_attack]
on_info = {+zat_noah_help_task_talk_start} sr_idle@create_attackers_1 %=clear_smart_radius(zat_sim_23:300)%

[sr_idle@create_attackers_1]
on_game_timer = 10 | sr_idle@create_attackers_2 %=create_squad(zat_noah_help_task_snork_attackers_1:zat_sim_23)%

[sr_idle@create_attackers_2]
on_game_timer = 10 | sr_idle@create_attackers_3 %=create_squad(zat_noah_help_task_snork_attackers_2:zat_sim_23)%

[sr_idle@create_attackers_3]
on_game_timer = 10 | sr_idle@create_attackers_4 %=create_squad(zat_noah_help_task_snork_attackers_3:zat_sim_23)%

[sr_idle@create_attackers_4]
on_game_timer = 10 | sr_idle@tp_attackers_1 %=create_squad(zat_noah_help_task_snork_attackers_4:zat_sim_23)%

[sr_idle@tp_attackers_1]
on_game_timer = 5 | sr_idle@tp_attackers_2 %=teleport_squad(zat_noah_help_task_snork_attackers_1:zat_b18_snork_spawn_1)%

[sr_idle@tp_attackers_2]
on_game_timer = 5 | sr_idle@tp_attackers_3 %=teleport_squad(zat_noah_help_task_snork_attackers_2:zat_b18_snork_spawn_2)%

[sr_idle@tp_attackers_3]
on_game_timer = 5 | sr_idle@tp_attackers_4 %=teleport_squad(zat_noah_help_task_snork_attackers_3:zat_b18_snork_spawn_3)%

[sr_idle@tp_attackers_4]
on_game_timer = 5 | sr_idle@count %=teleport_squad(zat_noah_help_task_snork_attackers_4:zat_b18_snork_spawn_4)%

[sr_idle@count]
on_info = {+zat_noah_help_task_snork_attackers_1_death +zat_noah_help_task_snork_attackers_2_death +zat_noah_help_task_snork_attackers_3_death +zat_noah_help_task_snork_attackers_4_death} sr_idle@end
on_info2 = {+zat_b18_noah_dead} nil %+zat_noah_help_task_fail%

[sr_idle@end]
on_game_timer = 50 | nil %+zat_noah_help_task_attackers_dead%