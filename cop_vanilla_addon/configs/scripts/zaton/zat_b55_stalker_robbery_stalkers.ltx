; Bandit Leader

[logic@zat_b55_bandit_leader]
active = walker@leader_position
suitable = {=check_npc_name(zat_b55_bandit_leader)} true, false
prior = 200
on_death = death@zat_b55_bandit_leader

[death@zat_b55_bandit_leader]
on_info = %+zat_b55_bandit_leader_dead =stop_sound%

[walker@leader_position]
path_walk = bandits_attackers_leader_shoot_walk
path_look = bandits_attackers_leader_shoot_look
def_state_moving = assault
def_state_standing = guard
meet = no_meet
combat_ignore_cond = {!actor_enemy} true, {=check_enemy_name(stalker)} true, false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_signal = path_end | remark@leader_threat
invulnerable = {!actor_enemy} true, false

[remark@leader_threat]
;target = story | zat_b55_bandit_leader_target
anim = threat_na
on_signal = anim_end | remark@leader_shoot %+zat_b55_bandit_leader_shoot%
meet = no_meet
combat_ignore_cond = {!actor_enemy} true, {=check_enemy_name(stalker)} true, false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false

[remark@leader_shoot]
;target = story | zat_b55_bandit_leader_target
anim = threat_fire
on_game_timer = 15 | {-zat_b55_bandit_leader_first} %+zat_b55_bandit_leader_first =play_sound(zat_b55_bandit_leader_first)%
on_signal = sound_end | remark@leader_call
meet = no_meet
combat_ignore_cond = {!actor_enemy} true, {=check_enemy_name(stalker)} true, false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false 

[remark@leader_call]
target = story | actor
anim = claim
on_info = {-zat_b55_bandit_leader_call} %=play_sound(gar_robbery_scene_come_here) =send_tip(st_zat_b55_bandit_leader_call:zat_b55_bandit_leader) +zat_b55_bandit_leader_call%
on_signal = sound_end | remark@leader_wait
meet = no_meet
combat_ignore_cond = {!actor_enemy} true, {=check_enemy_name(stalker)} true, false   
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false 

[remark@leader_wait]
target = story | actor
anim = guard
meet = meet@leader
combat_ignore_cond = {!actor_enemy} true, {=check_enemy_name(stalker)} true, false
; Если ГГ достал ствол и мы его еще не предупреждали - идем ругаться
on_info = {=actor_has_weapon -zat_b55_bandit_leader_last_warning_snd} remark@leader_angry
; Если ГГ уже предупреждали (он убрал ствол, а потом снова достал) - убить без разговоров
on_info2 = {=actor_has_weapon +zat_b55_bandit_leader_last_warning_snd} remark@leader_kill
; Сюжетные переходы
on_info3 = {+zat_b55_bandit_leader_first_deal_dlg_angry -zat_b55_bandit_leader_punch} remark@leader_punch %=disable_input_only%
on_info4 = {+zat_b55_bandit_leader_first_deal_dlg} walker@leader_stay

gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false

[remark@leader_angry]
target = story | actor
anim = threat_na
meet = no_meet
combat_ignore_cond = {!actor_enemy} true, {=check_enemy_name(stalker)} true, false
; Выдаем фразу-предупреждение
on_info = {-zat_b55_bandit_leader_last_warning_snd} %=play_sound(gar_robbery_scene_last_warning_weap) +zat_b55_bandit_leader_last_warning_snd%
; Если игрок послушался и убрал ствол - возвращаемся в ожидание
on_info2 = {!actor_has_weapon} remark@leader_wait
; Если прошло 5 секунд (50 тиков), а ствол всё еще в руках - идем убивать
on_game_timer = 50 | {=actor_has_weapon} remark@leader_kill

gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false

[remark@leader_kill]
target = story | actor
anim = threat_fire
meet = no_meet
combat_ignore_cond = {!actor_enemy} true, {=check_enemy_name(stalker)} true, false
; Орем "Вали его!"
on_info = %=play_sound(gar_robbery_scene_kill_actor)%
; Ждем полторы секунды (пока кричит) и делаем весь отряд врагами
on_game_timer = 15 | %=set_squad_enemy_to_actor(zat_b55_bandit_leader_squad) +zat_b55_stalker_actor_robbery_task_reversed%

gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false

[remark@leader_punch]
target = story | actor
anim = punch
meet = no_meet
combat_ignore_cond = {!actor_enemy} true, {=check_enemy_name(stalker)} true, false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_signal = anim_end | remark@leader_wait %+zat_b55_bandit_leader_punch =enable_input_only%

[walker@leader_stay]
path_walk = bandits_attackers_leader_shoot_walk
path_look = bandits_attackers_leader_shoot_look
def_state_moving = assault
def_state_standing = ward
meet = no_meet
combat_ignore_cond = {!actor_enemy} true, {=check_enemy_name(stalker)} true, false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false

[meet@leader]
close_anim 		= nil
close_victim 	= nil
far_anim 		= nil
far_victim 		= nil
close_distance  = 3
far_distance 	= 0
close_snd_distance = 0
use = {+zat_b55_bandit_leader_call -zat_b55_bandit_leader_first_deal_dlg =dist_to_actor_le(2)} self, false
meet_on_talking = false
allow_break = false
meet_dialog = {+zat_b55_bandit_leader_first_deal_dlg_angry} zat_b55_bandit_leader_first_deal_dlg_angry, {-zat_b55_bandit_leader_first_deal_dlg_angry} zat_b55_bandit_leader_first_deal_dlg

