[mob_walker@snork_normal_1]
path_walk = snork_1_jump_walk
path_look = snork_1_jump_look
on_signal = plato_snork_1_jump | {=actor_in_zone(zat_b28_heli_3_snork_territory) !actor_in_zone(zat_b28_heli_3_snork_territory_2)} mob_jump@snork_normal_1_jump_1, {=actor_in_zone(zat_b28_heli_3_snork_territory_2) !actor_in_zone(zat_b28_heli_3_snork_territory)} mob_jump@snork_normal_1_jump_2
out_restr = zat_b28_heli_3_snork_territory
combat_ignore_cond = true

[mob_jump@snork_normal_1_jump_1]
path_jump = snork_1_jump
ph_jump_factor = 1.4
offset = 0,0,0
on_signal = jumped | mob_home@snork_normal_1_attacker %+zat_b28_snork_1_jumped%
out_restr = zat_b28_heli_3_snork_territory
combat_ignore_cond = true

[mob_jump@snork_normal_1_jump_2]
path_jump = snork_1_jump_1
ph_jump_factor = 1.4
offset = 0,0,0
on_signal = jumped | mob_home@snork_normal_1_attacker %+zat_b28_snork_1_jumped%
out_restr = zat_b28_heli_3_snork_territory
combat_ignore_cond = true

[mob_home@snork_normal_1_attacker]
