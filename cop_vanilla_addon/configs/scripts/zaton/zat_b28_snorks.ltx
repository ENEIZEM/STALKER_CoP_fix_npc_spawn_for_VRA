home_min_radius = 20
home_max_radius = 40
on_info = {!npc_in_zone(zat_b28_smart_terrain_att)}  %=kill_npc()%
on_info2 = {=actor_in_zone(zat_b28_heli_3_snork_territory) -zat_b28_snork_normal_today_not_jumping -zat_b28_snork_1_jumped -zat_b28_heli_3_searched} mob_walker@snork_normal_1 %=teleport_npc(zat_b28_snork_1_jump_walk)%
