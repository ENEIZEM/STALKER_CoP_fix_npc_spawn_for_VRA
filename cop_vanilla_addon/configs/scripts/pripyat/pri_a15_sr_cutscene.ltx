[logic]
active = sr_idle@run_black

[sr_idle@run_black]
on_info = sr_idle@prestart %=disable_ui =run_postprocess(black:3009:true) =create_squad(pri_a15_squad:pri_a15) =create_squad(pri_a15_military_squad:pri_a15)%

[sr_idle@prestart]
on_game_timer = 5 | sr_idle@filter_vano %=teleport_actor(pri_a15_actor_start_walk:pri_a15_actor_start_look) =create_cutscene_actor_with_weapon(pri_a15_actor:pri_a15_actor_spawn)%

; =======================================================
; ФИЛЬТРАЦИЯ СКВАДА (ВЫЧЁРКИВАЕМ МЁРТВЫХ ИЗ КВАДА)
; =======================================================
[sr_idle@filter_vano]
on_info = {+pri_a15_vano_out} sr_idle@filter_sokolov %=remove_npc(pri_a15_vano)%, sr_idle@filter_sokolov

[sr_idle@filter_sokolov]
on_info = {+pri_a15_sokolov_out} sr_idle@filter_zulus %=remove_npc(pri_a15_sokolov_scene)%, sr_idle@filter_zulus

[sr_idle@filter_zulus]
on_info = {+pri_a15_zulus_out} sr_idle@filter_wanderer %=remove_npc(pri_a15_zulus)%, sr_idle@filter_wanderer

[sr_idle@filter_wanderer]
on_info = {+pri_a15_wanderer_out} sr_idle@check_all_dead %=remove_npc(pri_a15_wanderer)%, sr_idle@check_all_dead

[sr_idle@check_all_dead]
; Если мертвы все — сносим сам сквад, чтобы не висел пустым мусором
on_info = {+pri_a15_vano_out +pri_a15_sokolov_out +pri_a15_zulus_out +pri_a15_wanderer_out} sr_idle@start %=remove_squad(pri_a15_squad)%
on_info2 = sr_idle@start

; =======================================================

[sr_idle@start]
on_info = {+pas_b400_done} sr_idle@give_info
on_info2 = {-pas_b400_done} sr_idle@nil %+pri_a15_cutscene_end =teleport_actor(pri_a15_actor_start_walk:pri_a15_actor_start_look)%   

[sr_idle@give_info]
on_info = { -pri_a15_vano_out -pri_a15_sokolov_out -pri_a15_zulus_out -pri_a15_wanderer_out} sr_idle@start_cam %+pri_a15_all_alive%
on_info2 = { +pri_a15_vano_out -pri_a15_sokolov_out -pri_a15_zulus_out -pri_a15_wanderer_out} sr_idle@start_cam %+pri_a15_1_vano%
on_info3 = { -pri_a15_vano_out +pri_a15_sokolov_out -pri_a15_zulus_out -pri_a15_wanderer_out} sr_idle@start_cam %+pri_a15_1_sokolov%
on_info4 = { -pri_a15_vano_out -pri_a15_sokolov_out +pri_a15_zulus_out -pri_a15_wanderer_out} sr_idle@start_cam %+pri_a15_1_zulus%
on_info5 = { -pri_a15_vano_out -pri_a15_sokolov_out -pri_a15_zulus_out +pri_a15_wanderer_out} sr_idle@start_cam %+pri_a15_1_wanderer%
on_info6 = { +pri_a15_vano_out +pri_a15_sokolov_out -pri_a15_zulus_out -pri_a15_wanderer_out} sr_idle@start_cam %+pri_a15_2_vano_sokolov%
on_info7 = { +pri_a15_vano_out -pri_a15_sokolov_out +pri_a15_zulus_out -pri_a15_wanderer_out} sr_idle@start_cam %+pri_a15_2_vano_zulus%
on_info8 = { +pri_a15_vano_out -pri_a15_sokolov_out -pri_a15_zulus_out +pri_a15_wanderer_out} sr_idle@start_cam %+pri_a15_2_vano_wanderer%
on_info9 = { -pri_a15_vano_out +pri_a15_sokolov_out +pri_a15_zulus_out -pri_a15_wanderer_out} sr_idle@start_cam %+pri_a15_2_sokolov_zulus%
on_info10 = { -pri_a15_vano_out +pri_a15_sokolov_out -pri_a15_zulus_out +pri_a15_wanderer_out} sr_idle@start_cam %+pri_a15_2_sokolov_wanderer%
on_info11 = { -pri_a15_vano_out -pri_a15_sokolov_out +pri_a15_zulus_out +pri_a15_wanderer_out} sr_idle@start_cam %+pri_a15_2_zulus_wanderer%
on_info12 = { +pri_a15_vano_out +pri_a15_sokolov_out +pri_a15_zulus_out -pri_a15_wanderer_out} sr_idle@start_cam %+pri_a15_3_wanderer_alive%
on_info13 = { +pri_a15_vano_out +pri_a15_sokolov_out -pri_a15_zulus_out +pri_a15_wanderer_out} sr_idle@start_cam %+pri_a15_3_zulus_alive%
on_info14 = { +pri_a15_vano_out -pri_a15_sokolov_out +pri_a15_zulus_out +pri_a15_wanderer_out} sr_idle@start_cam %+pri_a15_3_sokolov_alive%
on_info15 = { -pri_a15_vano_out +pri_a15_sokolov_out +pri_a15_zulus_out +pri_a15_wanderer_out} sr_idle@start_cam %+pri_a15_3_vano_alive%
on_info16 = { +pri_a15_vano_out +pri_a15_sokolov_out +pri_a15_zulus_out +pri_a15_wanderer_out} sr_idle@start_cam %+pri_a15_all_dead%

[sr_idle@start_cam]
on_game_timer = 20 | sr_idle@wait %=stop_postprocess(3009) +pri_a15_cutscene_go =update_npc_logic(pri_a15_actor:pri_a15_vano:pri_a15_sokolov_scene:pri_a15_zulus:pri_a15_wanderer:pri_a15_military_tarasov:pri_a15_military_2:pri_a15_military_3:pri_a15_military_4) =update_obj_logic(pri_a15_exit)%

[sr_idle@wait]
on_info = {+pri_a15_cutscene_end} sr_idle@end %=run_postprocess(fade_to_black_9_sec)%

[sr_idle@end]
on_game_timer = 75 | sr_idle@nil %=run_postprocess(black:3009:true)%
on_info = {+pri_a16_kovalski_start} sr_idle@nil

[sr_idle@nil]