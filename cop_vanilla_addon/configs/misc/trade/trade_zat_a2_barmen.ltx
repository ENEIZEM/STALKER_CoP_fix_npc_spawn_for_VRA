[trader]
resupply_interval         = 36, 72   ; Обновление ассортимента полное случайно от x до y часов (дефолт: 48)
dynamic_update_interval   = 1, 2     ; Обновление частичное случайно от x до y часа (дефолт: 1)
changes                   = 1, 4     ; Сколько предметов меняем? От x до y изменений за раз (дефолт: 1, 5)

chance_buy_out            = 90       ; Исчезновения товара из продажи в dynamic_update_interval (%)
