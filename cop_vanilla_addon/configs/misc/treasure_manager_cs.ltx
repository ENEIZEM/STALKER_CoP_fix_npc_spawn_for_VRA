; target - ID стори-объекта и имя ящика ;story_id и name инвентарного ящика должны совпадать!
; custom_spot = свой спот взамен treasure hint, префикс treasure_ подставится автоматически
; name - название тайника (строковый ID)  
; description - описание тайника (строковый ID)
; items - предметы в формате: секция, кол-во | секция, кол-во ; ammo спаунится не в пачках, а в количестве по единицам
; Поддерживает рандомные пресеты айтемов, например:
; items = ammo_9x19_fmj, 30 | bandage, 2 | wpn_abakan, 1
; items1 = ammo_9x19_fmj, 90 | bandage, 5
; items2 = ammo_9x19_fmj, 30 | bandage, 2 | wpn_ak74, 1
; items3 и так далее, то есть каждый раз в тайнике у вас появятся предметы из четырёх возможных пресетов. Их количество ограничено 99.
; rank - минимальный ранг: novice|stalker|veteran|master (для трупов), по дефолту стоит all (все ранги!)
; community - доступные группировки через запятую (для трупов)
; on_empty - кондлист при опустошении тайника
; condlist - условия доступности тайника для выдачи NPC, если true, только тогда выполняются остальные условия (не влияет на give_treasure)!
; items_on_game_start - если true (по умолчанию), то предметы будут в тайнике со старта игры, если false, то как в ТЧ после получения наводки
; [banned_names] содержит секции персонажей, которые запрещены к выпадению тайников с их трупов (на всякий случай если кому надо, просто оставил как в TS, но вывел в конфиг)

[settings]
dead_body_stash_chance = 10 ;шанс в % выдать тайник при обыске трупа

[banned_names]
zat_b30_owl_stalker_trader = true

