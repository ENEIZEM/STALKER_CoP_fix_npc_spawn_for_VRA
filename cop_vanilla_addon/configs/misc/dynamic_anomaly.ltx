[settings]
; Включить спавн артефактов? (true/false)
enable_artifact_spawn = true

; Радиус разброса от центра смарта (в метрах)
max_offset_x = 50
max_offset_y = 5
max_offset_z = 50

; Количество попыток найти валидную точку (чтобы не спавнить в стенах)
max_tries = 50

; Шанс спавна артефакта при СМЕРТИ в аномалии (0.0 - 0%, 1.0 - 100%)
chance_spawn_on_death = 0.3

; Шанс спавна артефакта при ВЫБРОСЕ (когда аномалия исчезает)
chance_spawn_on_blowout = 0.2

; Максимальная высота спавна для air_spawn_allowed (в метрах над землей)
air_spawn_height = 25

; Количество аномалий на один смарт
anoms_per_smart_min = 1
anoms_per_smart_max = 4

; Радиус самой аномалии (физический)
anomaly_radius = 3

; Настройки для zone_field_ (радиация, пси и т.д.)
; Радиус будет выбираться случайно между этими числами
field_radius_min = 3
field_radius_max = 10

; Список возможных аномалий
[anomalies_list]
zone_field_radioactive_weak
zone_field_radioactive_average
zone_field_psychic_average
zone_mine_electric_average
zone_mine_electric_strong
zone_mine_gravitational_weak
zone_mine_gravitational_average
zone_mine_gravitational_strong
zone_mine_thermal_average
zone_mine_thermal_strong

; Читает по подсекции (какие аномалии могут быть в воздухе со смещением в air_spawn_height)
[air_spawn_allowed]
zone_mine_electric
zone_mine_gravitational

; Читает по подсекции (где спаунятся артефакты)
[artifact_groups]
zone_mine_gravitational
zone_mine_thermal
zone_mine_electric
zone_field_psychic

[zone_mine_gravitational]
af_medusa
af_cristall_flower
af_night_star
af_vyvert

[zone_mine_thermal]
af_drops
af_cristall
af_fireball
af_eye

[zone_mine_electric]
af_electra_sparkler
af_electra_flash
af_electra_moonlight
af_dummy_spring

[zone_field_psychic]
af_cristall_flower
af_electra_moonlight

; Список уровней, где работает скрипт
[allowed_levels]
zaton
jupiter
pripyat

