; From: CoC - Alundaio
; Explanations
; Although the condlist supports any info, in this case the spot will only update if actor has any alife_info (infoportions like).
; enable = {+has_info} true, false 
; Name of waypoint that is placed in the CLevelChanger object of your SDK.
; path = zaton_space_restrictor_to_jupiter_drop
; Name of waypoint that teleports the player away from the restrictor if they refuse to move to another location.
; reject_path = zaton_way_if_reject_to_jupiter
; Flag determines if reject_path is triggered when enable = false
; reject_on_disabled bool

; ZATON

[zaton_space_restrictor_to_jupiter]
enable = {+zat_b215_gave_maps +jup_b217_welcome_tech_talked} true, false
spot = level_changer_down
text = st_level_changer_descr
hint = space_restrictor_to_jupiter_desc
path = zaton_space_restrictor_to_jupiter_drop
reject_path = zaton_way_if_reject_to_jupiter
reject_on_disabled = false
autosave = true

