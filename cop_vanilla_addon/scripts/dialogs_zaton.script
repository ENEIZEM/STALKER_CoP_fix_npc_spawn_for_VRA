function zat_b103_lost_merc_leader_heli_2_searched_dlg_maps_wpn_check_has(first_speaker, second_speaker)
    local excluded_weapons = {
        "wpn_bm16",
        "wpn_fort",	
        "wpn_colt1911",
        "wpn_hpsa",	
        "wpn_mp5",
        "wpn_pb",	
        "wpn_ak74u",
        "wpn_pm",	
        "wpn_sig220",
        "wpn_toz34",	
        "wpn_walther",
        "wpn_usp",				
        "wpn_beretta"
    }
    
    local excluded_outfits = {
        "bandit_trenchcoat_outfit",
        "rookie_jacket_black_outfit",	
        "rookie_jacket_outfit"
    }
    
    -- Вспомогательная функция для проверки наличия в таблице
    local function contains(tbl, item)
        for _, v in pairs(tbl) do
            if v == item then
                return true
            end
        end
        return false
    end
    
    local has_weapon = false
    local has_outfit = false
    
    -- Проверяем слот (оружие)
    local has_weapon = false
    for slot_id = 2, 3 do
        local item = db.actor:item_in_slot(slot_id)
        if item and string.find(item:section(), "^wpn_") then
            local section = item:section()
            if not contains(excluded_weapons, section) then
                has_weapon = true
                break
            end
        end
    end
    
    -- Проверяем слот 7 (броня)
    local slot7_item = db.actor:item_in_slot(7)
    if slot7_item ~= nil then
        local section = slot7_item:section()
        if string.find(section, "outfit") and not contains(excluded_outfits, section) then
            has_outfit = true
        end
    end
    
    -- Возвращаем true только если есть И оружие И броня
    if has_weapon and has_outfit then
		return true
	else 
		return false
	end
end

function zat_b103_lost_merc_leader_heli_2_searched_dlg_maps_wpn_check_hasnt(first_speaker, second_speaker)
    if zat_b103_lost_merc_leader_heli_2_searched_dlg_maps_wpn_check_has(first_speaker, second_speaker) == false then
	 	return true
    else 
		return false
	end
end

