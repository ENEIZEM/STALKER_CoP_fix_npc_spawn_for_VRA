end

--Zaton B52

-- Таблицу можно оставить, дополнять или полностью очистить ({})
-- Для STCoP и прочего непотребства

local nimble_weapons = {
    -- ["wpn_groza_spec"] = true,
    -- ["wpn_svd_custom"] = true
}

-- Вспомогательная локальная функция, чтобы не дублировать код проверок
local function is_nimble_sec(sec)
    if not sec then return false end
    
    -- 1. Проверка по подстроке "nimble" (моментально находит 99% стволов Шустрого)
    if string.find(sec, "nimble", 1, true) then
        return true
    end
    
    -- 2. Страховка по таблице (для уникальных названий из модов)
    if nimble_weapons[sec] then
        return true
    end

    return false
end

--------------------------------------------------------------------------------
-- 1. ПРОВЕРКА: Есть ли ствол Шустрого где-либо в инвентаре?
--------------------------------------------------------------------------------
function actor_has_nimble_weapon(actor, npc)
    local a = db.actor
    if not a then return false end

    local has_item = false

    a:iterate_inventory(function(dummy, item)
        if has_item then return end
        
        if is_nimble_sec(item:section()) then
            has_item = true
        end
    end, nil)

    return has_item
end

----------------------------------------------------------------------------------------------------
-- Ограбление (высчитываем самый дорогой ствол и забираем вместе с бабками)
----------------------------------------------------------------------------------------------------
function zat_b51_robbery(first_speaker, second_speaker)
    local actor = db.actor
    if not actor then return end

    -- 1. ГРАБИМ ДЕНЬГИ
    local current_money = actor:money()
    local amount = math.floor(current_money * math.random(35, 50) / 100)
    
    if amount > 0 then
        -- Сохраняем точную сумму в память
        xr_logic.pstor_store(actor, "zat_b51_stolen_money", amount)
        dialogs.relocate_money_from_actor(first_speaker, second_speaker, amount)
    end

    -- 2. ИЩЕМ САМЫЙ ДОРОГОЙ СТВОЛ
    local max_cost = -1
    local best_weapon_sec = nil
    local ini = system_ini()

    actor:iterate_inventory(function(dummy, item)
        local sec = item:section()
        
        -- Проверяем, что секция существует и у неё есть класс
        if ini:section_exist(sec) and ini:line_exist(sec, "class") then
            local cls = ini:r_string(sec, "class")
            
            -- Отсеиваем ножи, болты и бинокли. Оставляем только огнестрел (класс начинается на WP_)
            if string.find(cls, "WP_") and cls ~= "WP_BINOC" and cls ~= "WP_KNIFE" then
                local cost = ini:r_u32(sec, "cost")
                
                -- Ищем максимальную цену
                if cost > max_cost then
                    max_cost = cost
                    best_weapon_sec = sec
                end
            end
        end
    end, nil)

    -- 3. ИЗЫМАЕМ СТВОЛ
    if best_weapon_sec then
        -- Запоминаем секцию украденного ствола в память
        xr_logic.pstor_store(actor, "zat_b51_stolen_weapon", best_weapon_sec)
        
        -- Выдаем инфопоршень, как ты и просил (если он нужен для диалогов)
        actor:give_info_portion("info_zat_b51_robbery_" .. best_weapon_sec)
        
        -- Забираем 1 штуку самого дорогого ствола
        dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, best_weapon_sec, 1)
    end
end

----------------------------------------------------------------------------------------------------
-- Возврат награбленного (читаем память и возвращаем)
----------------------------------------------------------------------------------------------------
function zat_b51_return_stolen_items(first_speaker, second_speaker)
    local actor = db.actor
    if not actor then return end

    -- 1. ВОЗВРАЩАЕМ ДЕНЬГИ
    local stolen_money = xr_logic.pstor_retrieve(actor, "zat_b51_stolen_money", 0)
    if stolen_money > 0 then
        dialogs.relocate_money_to_actor(first_speaker, second_speaker, stolen_money)
        -- Обнуляем память, чтобы нельзя было забрать деньги дважды
        xr_logic.pstor_store(actor, "zat_b51_stolen_money", 0) 
    end

    -- 2. ВОЗВРАЩАЕМ СТВОЛ
    local stolen_weapon = xr_logic.pstor_retrieve(actor, "zat_b51_stolen_weapon", "")
    if stolen_weapon ~= "" then
        dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, stolen_weapon)
        
        -- Убираем инфопоршень
        local info_portion = "info_zat_b51_robbery_" .. stolen_weapon
        if has_alife_info(info_portion) then
            actor:disable_info_portion(info_portion)
        end
        
        -- Очищаем память
        xr_logic.pstor_store(actor, "zat_b51_stolen_weapon", "")
    end
end

function zat_b51_rob_nimble_weapon(first_speaker, second_speaker)
	local actor = db.actor
	if not actor then return end

	local ini = system_ini()
	local max_cost = -1
	local best_nimble_sec = nil

	-- I?iaa?yai aanu eiaaioa?u (aee??ay neiou)
	actor:iterate_inventory(function(dummy, item)
		local sec = item:section()
		if is_nimble_sec(sec) then
			local cost = 0
			if ini:section_exist(sec) and ini:line_exist(sec, "cost") then
				cost = ini:r_u32(sec, "cost")
			end

			if cost > max_cost then
				max_cost = cost
				best_nimble_sec = sec
			end
		end
	end, nil)

	-- Caae?aai iaeaaiiue naiue ai?iaie noaie
	if best_nimble_sec then
		dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, best_nimble_sec)
	end
end

-- Zaton B18

function give_compass_to_actor(first_speaker, second_speaker)
	dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "af_compass")
end

-- b51
----------------------------------------------------------------------------------------------------
-- НАСТРОЙКИ ЭКОНОМИКИ ШУСТРОГО
----------------------------------------------------------------------------------------------------

local MARKUP         = 1.5   -- Наценка Шустрого (50% к базовой цене предмета)
local PREPAY_NORM    = 0.25  -- Предоплата 10% (если всё ок)
local PREPAY_REFUSED = 0.50  -- Предоплата 25% (если до этого отказался от заказа)

-- Компактная таблица товаров Шустрого
local nimble_items = {
    [1] = { {"wpn_desert_eagle_nimble"}, {"wpn_sig220_nimble"}, {"wpn_usp_nimble"} },
    [2] = { {"wpn_mp5_nimble"}, {"wpn_spas12_nimble"}, {"wpn_protecta_nimble"} },
    [3] = { {"wpn_groza_nimble"}, {"wpn_g36_nimble"}, {"wpn_fn2000_nimble"} },
    [4] = { {"wpn_vintorez_nimble"}, {"wpn_svu_nimble"}, {"wpn_svd_nimble"} },
    [5] = { {"helm_tactic", "cs_heavy_outfit"} }, -- Несколько предметов в одном заказе
    [6] = { {"scientific_outfit"} },
    [7] = { {"merc_exo_outfit"} }
}

----------------------------------------------------------------------------------------------------
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ВЫЧИСЛЕНИЯ ЦЕН И ПРЕДМЕТОВ
----------------------------------------------------------------------------------------------------

-- Получаем базовую стоимость секции (если есть родитель без _nimble - берем его)
local function get_base_cost(sec)
    local ini = system_ini()
    local parent_sec = sec:gsub("_nimble", "")
    
    if ini:section_exist(parent_sec) and ini:line_exist(parent_sec, "cost") then
        return ini:r_u32(parent_sec, "cost")
    elseif ini:section_exist(sec) and ini:line_exist(sec, "cost") then
        return ini:r_u32(sec, "cost")
    end
    return 1000 -- Страховка на случай кривого конфига
end

-- Ищем, какая категория и какой предмет сейчас в работе
local function get_active_order()
    for cat_idx = 1, 7 do
        if has_alife_info("zat_b51_processing_category_" .. cat_idx) then
            for item_idx = 1, #nimble_items[cat_idx] do
                if has_alife_info("zat_b51_ordered_item_" .. cat_idx .. "_" .. item_idx) then
                    return cat_idx, item_idx
                end
            end
            return cat_idx, nil
        end
    end
    return nil, nil
end

-- Главный математик: возвращает Общую стоимость, Предоплату и Оставшуюся сумму к оплате
local function get_order_financials()
    local cat_idx, item_idx = get_active_order()
    if not cat_idx then return 0, 0, 0 end
    
    -- Если предмет еще не сгенерирован (на этапе диалога о предоплате), генерим его тут же!
    if not item_idx then
        local available = {}
        for j = 1, #nimble_items[cat_idx] do
            if not has_alife_info("zat_b51_done_item_" .. cat_idx .. "_" .. j) then
                table.insert(available, j)
            end
        end
        item_idx = #available > 0 and available[math.random(1, #available)] or 1
        db.actor:give_info_portion("zat_b51_ordered_item_" .. cat_idx .. "_" .. item_idx)
    end

    -- Считаем базовую стоимость (учитывая, что в заказе может быть несколько предметов, как костюм + шлем)
    local base_cost = 0
    for _, sec in ipairs(nimble_items[cat_idx][item_idx]) do
        base_cost = base_cost + get_base_cost(sec)
    end

    local total_cost = math.floor(base_cost * MARKUP)
    local is_refused = has_alife_info("zat_b51_order_refused")
    local prepay = math.floor(total_cost * (is_refused and PREPAY_REFUSED or PREPAY_NORM))
    local remainder = total_cost - prepay -- Сумма, которую нужно отдать при получении товара

    return total_cost, prepay, remainder
end

----------------------------------------------------------------------------------------------------
-- ФУНКЦИИ ДЛЯ ДИАЛОГОВ (Управление транзакциями)
----------------------------------------------------------------------------------------------------

-- Принудительный рандом (если вызывается из диалога)
function zat_b51_randomize_item(first_speaker, second_speaker)
    get_order_financials() -- Эта функция сама сгенерирует предмет, если его нет
end

-- Отдаем предоплату
function zat_b51_give_prepay(first_speaker, second_speaker)
    local _, prepay, _ = get_order_financials()
    if prepay > 0 then
        dialogs.relocate_money_from_actor(first_speaker, second_speaker, prepay)
    end
end

-- Проверка: хватает ли на предоплату?
function zat_b51_has_prepay(first_speaker, second_speaker)
    local _, prepay, _ = get_order_financials()
    return db.actor:money() >= prepay
end

function zat_b51_hasnt_prepay(first_speaker, second_speaker)
    return not zat_b51_has_prepay(first_speaker, second_speaker)
end

-- Выкуп товара (оплата остатка и выдача предметов)
function zat_b51_buy_item(first_speaker, second_speaker)
    local cat_idx, item_idx = get_active_order()
    if not cat_idx or not item_idx then return end

    local _, _, remainder = get_order_financials()

    -- Отдаем предметы
    for _, sec in ipairs(nimble_items[cat_idx][item_idx]) do
        dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, sec)
    end
    
    -- Забираем остаток денег
    dialogs.relocate_money_from_actor(first_speaker, second_speaker, remainder)

    -- Работа с инфопоршнями (закрытие заказа)
    disable_info("zat_b51_processing_category_" .. cat_idx)
    disable_info("zat_b51_ordered_item_" .. cat_idx .. "_" .. item_idx)
    give_info("zat_b51_done_item_" .. cat_idx .. "_" .. item_idx)
    
    -- Логика прощения отказов
    if has_alife_info("zat_b51_order_refused") then
        if has_alife_info("zat_b51_forgiven_step_1") then
            disable_info("zat_b51_order_refused")
            disable_info("zat_b51_forgiven_step_1")
        else
            give_info("zat_b51_forgiven_step_1")
        end
    end

    -- Проверяем, выкуплена ли вся категория полностью
    local category_finishing = true
    for j = 1, #nimble_items[cat_idx] do
        if not has_alife_info("zat_b51_done_item_" .. cat_idx .. "_" .. j) then
            category_finishing = false
            break
        end
    end
    if category_finishing then
        give_info("zat_b51_finishing_category_" .. cat_idx)
    end
end

-- Отказ от товара
function zat_b51_refuse_item(first_speaker, second_speaker)
    local cat_idx, item_idx = get_active_order()
    if not cat_idx or not item_idx then return end

    disable_info("zat_b51_processing_category_" .. cat_idx)
    disable_info("zat_b51_ordered_item_" .. cat_idx .. "_" .. item_idx)
    give_info("zat_b51_done_item_" .. cat_idx .. "_" .. item_idx)
    
    if has_alife_info("zat_b51_forgiven_step_1") then
        disable_info("zat_b51_forgiven_step_1")
    end

    local category_finishing = true
    for j = 1, #nimble_items[cat_idx] do
        if not has_alife_info("zat_b51_done_item_" .. cat_idx .. "_" .. j) then
            category_finishing = false
            break
        end
    end
    if category_finishing then
        give_info("zat_b51_finishing_category_" .. cat_idx)
    end
end

-- Проверка: хватает ли на оплату остатка при получении?
function zat_b51_has_item_cost(first_speaker, second_speaker)
    local _, _, remainder = get_order_financials()
    return db.actor:money() >= remainder
end

function zat_b51_hasnt_item_cost(first_speaker, second_speaker)
    return not zat_b51_has_item_cost(first_speaker, second_speaker)
end

----------------------------------------------------------------------------------------------------
-- ГЕНЕРАЦИЯ ТЕКСТА ДЛЯ ДИАЛОГОВ
----------------------------------------------------------------------------------------------------

function get_nimble_category_name(index)
    local categories = {
        "st_nimble_category_1", "st_nimble_category_2", "st_nimble_category_3",
        "st_nimble_category_4", "st_nimble_category_5", "st_nimble_category_6", "st_nimble_category_7"
    }
    return game.translate_string(categories[index])
end

-- Текст ПРЕДОПЛАТЫ ("Обойдется в X, гони задаток Y")
function nimble_prepay_text(actor, npc, dialog_id, phrase_id)
    local cat_idx, _ = get_active_order()
    if not cat_idx then return "error" end
    
    local total_cost, prepay, _ = get_order_financials()
    local cat_name = get_nimble_category_name(cat_idx)
    
    local template_id = has_alife_info("zat_b51_order_refused") and "st_nimble_prepay_refused_template" or "st_nimble_prepay_template"
    return string.format(game.translate_string(template_id), cat_name, total_cost, prepay)
end

-- Текст ФИНАЛЬНОЙ ОПЛАТЫ ("Принёс тебе [Ствол], с тебя еще X")
function nimble_final_pay_text(actor, npc, dialog_id, phrase_id)
    local cat_idx, item_idx = get_active_order()
    if not cat_idx or not item_idx then return "error" end

    local _, _, remainder = get_order_financials()
    local section = nimble_items[cat_idx][item_idx][1]
    local item_name = game.translate_string(system_ini():r_string(section, "inv_name"))

    return string.format(game.translate_string("st_nimble_final_pay_template"), item_name, remainder)
end

-- Очистка всех категорий (для диалогов)
function zat_b51_clear_category_infos()
    for i = 1, 7 do
        disable_info("zat_b51_processing_category_" .. i)
    end
end

--b12

function zat_b12_actor_have_documents(first_speaker, second_speaker)
	if db.actor:object("zat_b12_documents_1") ~= nil
		or db.actor:object("zat_b12_documents_2") ~= nil then
		return true
	end

	return false
end

function zat_b12_actor_transfer_documents(first_speaker, second_speaker)
	local amount_doc1 = 1000
	local amount_doc2 = 600
	local amount_doc3 = 400
	local amount_total = 0
	local npc = dialogs.who_is_npc(first_speaker, second_speaker)
	local cnt = 0
 	local cnt2 = 0

	local function zat_b12_check_npc(temp, item)
		if item:section() == "zat_b12_documents_2" then
			cnt = cnt + 1
		end
	end

	local function zat_b12_check_actor(temp, item)
		if item:section() == "zat_b12_documents_2" then
			cnt2 = cnt2 + 1
		end
	end

	if db.actor:object("zat_b12_documents_1") ~= nil then
		dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, "zat_b12_documents_1")
		db.actor:give_info_portion("zat_b12_documents_sold_1")
		amount_total = amount_total + amount_doc1
	end

	npc:iterate_inventory(zat_b12_check_npc, nil)
	db.actor:iterate_inventory(zat_b12_check_actor, nil)

	if db.actor:object("zat_b12_documents_2") ~= nil then
		if cnt < 1 then
			amount_total = amount_total + amount_doc2
			if cnt2 > 1 then
				amount_total = amount_total + amount_doc3*(cnt2-1)
				db.actor:give_info_portion("zat_b12_documents_sold_2")
			end
		else
			amount_total = amount_total + amount_doc3*cnt2
			db.actor:give_info_portion("zat_b12_documents_sold_3")
		end
		dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, "zat_b12_documents_2", cnt2)
	end

	dialogs.relocate_money_to_actor(first_speaker, second_speaker, amount_total)
	return false
end

