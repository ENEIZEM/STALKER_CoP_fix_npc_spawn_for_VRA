--------------------------------------------------------------------------------
-- ECONOMY: GUIDE PILOT (Zaton <-> Jupiter, Zaton -> Pripyat)
--------------------------------------------------------------------------------
local PILOT_COST_REGULAR          = 5000   -- Zaton <-> Yanov (standard price)
local PILOT_COST_DISCOUNT         = 3000   -- Zaton <-> Yanov (with maps discount)
local PILOT_PRIPYAT_COST_REGULAR  = 13000   -- Zaton -> Pripyat (standard price)
local PILOT_PRIPYAT_COST_DISCOUNT = 11000   -- Zaton -> Pripyat (with maps discount)

-- Money check conditions: Zaton <-> Jupiter
function zat_b215_actor_has_money_regular(first_speaker, second_speaker)
	return db.actor:money() >= PILOT_COST_REGULAR
end

function zat_b215_actor_has_no_money_regular(first_speaker, second_speaker)
	return db.actor:money() < PILOT_COST_REGULAR
end

function zat_b215_actor_has_money_discount(first_speaker, second_speaker)
	return db.actor:money() >= PILOT_COST_DISCOUNT
end

function zat_b215_actor_has_no_money_discount(first_speaker, second_speaker)
	return db.actor:money() < PILOT_COST_DISCOUNT
end

-- Money check conditions: Zaton -> Pripyat
function zat_b215_actor_has_money_regular_pripyat(first_speaker, second_speaker)
	return db.actor:money() >= PILOT_PRIPYAT_COST_REGULAR
end

function zat_b215_actor_has_no_money_regular_pripyat(first_speaker, second_speaker)
	return db.actor:money() < PILOT_PRIPYAT_COST_REGULAR
end

function zat_b215_actor_has_money_discount_pripyat(first_speaker, second_speaker)
	return db.actor:money() >= PILOT_PRIPYAT_COST_DISCOUNT
end

function zat_b215_actor_has_no_money_discount_pripyat(first_speaker, second_speaker)
	return db.actor:money() < PILOT_PRIPYAT_COST_DISCOUNT
end

-- Money relocation actions: Zaton <-> Jupiter
function zat_b215_relocate_money_regular(first_speaker, second_speaker)
	dialogs.relocate_money_from_actor(first_speaker, second_speaker, PILOT_COST_REGULAR)
end

function zat_b215_relocate_money_discount(first_speaker, second_speaker)
	dialogs.relocate_money_from_actor(first_speaker, second_speaker, PILOT_COST_DISCOUNT)
end

-- Money relocation actions: Zaton -> Pripyat
function zat_b215_relocate_money_regular_pripyat(first_speaker, second_speaker)
	dialogs.relocate_money_from_actor(first_speaker, second_speaker, PILOT_PRIPYAT_COST_REGULAR)
end

function zat_b215_relocate_money_discount_pripyat(first_speaker, second_speaker)
	dialogs.relocate_money_from_actor(first_speaker, second_speaker, PILOT_PRIPYAT_COST_DISCOUNT)
end

