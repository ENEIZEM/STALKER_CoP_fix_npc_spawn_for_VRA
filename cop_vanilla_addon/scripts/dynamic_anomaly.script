--------------------------------------------------------------------------------
-- File: DYNAMIC_ANOMALY.SCRIPT
-- Description: Динамические аномалии + Спавн артефактов
--------------------------------------------------------------------------------

random_anomaly_id = {} 
spawned_artifacts_id = {}

-- === НОВЫЕ ПЕРЕМЕННЫЕ ДЛЯ КЭША ===
local enable_arts = false
local chance_death = 0
local chance_blowout = 0
local art_groups_cache = {} -- Кэш групп артефактов
local cached_ini = nil

function release()
	-- Перед удалением пробуем заспавнить арты (событие Blowout)
	load_settings() -- Обновляем настройки перед выбросом
	
	for art_id, _ in pairs(spawned_artifacts_id) do
		local art_se_obj = alife():object(art_id)
		if art_se_obj then
			-- ВАЖНО: parent_id == 65535 означает, что объект не принадлежит никому (валяется на земле).
			-- Если его подобрал ГГ, НПС или он в тайнике - его parent_id будет равен ID владельца, 
			-- и мы такой артефакт НЕ удаляем.
			if art_se_obj.parent_id == 65535 then
				alife():release(art_se_obj, true)
			end
		end
	end
	spawned_artifacts_id = {} -- Очищаем таблицу после удаления мусора	
	
	if enable_arts and chance_blowout > 0 then
		for k,v in pairs(random_anomaly_id) do
			local se_obj = alife():object(v)
			if se_obj then
				-- Спавним с шансом выброса
				if math.random() < chance_blowout then
					try_spawn_artifact(se_obj)
				end
			end
		end
	end

	-- Удаление аномалий
	for k,v in pairs(random_anomaly_id) do
		local se_obj = alife():object(v)
		if se_obj then
			alife():release(se_obj, true)
		end
	end
	random_anomaly_id = {}
end

function is_already_spawned_on_level()
	local current_level = level.name()
	for k, id in pairs(random_anomaly_id) do
		local se_obj = alife():object(id)
		if se_obj then
			-- Получаем локацию, на которой находится аномалия
			local gv = se_obj.m_game_vertex_id
			local lvl_id = game_graph():vertex(gv):level_id()
			local lvl_name = alife():level_name(lvl_id)
			
			-- Если нашли хотя бы одну нашу аномалию на текущей локации, значит спавн уже был
			if lvl_name == current_level then
				return true 
			end
		end
	end
	return false
end

function spawn()

	if is_already_spawned_on_level() then 
		return -- Прерываем функцию, если аномалии на этой локации уже есть
	end

	local ini = ini_file("misc\\dynamic_anomaly.ltx")
	if not ini:section_exist("settings") then return end

	-- Загружаем настройки артефактов
	load_settings(ini)

	local level_name = level.name()
	if not ini:section_exist("allowed_levels") or not ini:line_exist("allowed_levels", level_name) then return end
	if not ini:section_exist(level_name) then return end

	local max_offset_x     = ini:r_float("settings", "max_offset_x")
	local max_offset_y     = ini:r_float("settings", "max_offset_y")
	local max_offset_z     = ini:r_float("settings", "max_offset_z")
	local max_tries        = ini:r_s32("settings", "max_tries")
	local count_min        = ini:r_s32("settings", "anoms_per_smart_min")
	local count_max        = ini:r_s32("settings", "anoms_per_smart_max")
	local air_spawn_height = ini:r_float("settings", "air_spawn_height") or 0
	
	local default_radius   = ini:r_float("settings", "anomaly_radius")
	local field_r_min      = ini:r_float("settings", "field_radius_min") or 5
	local field_r_max      = ini:r_float("settings", "field_radius_max") or 10

	local anomaly_types = {}
	if ini:section_exist("anomalies_list") then
		local count = ini:line_count("anomalies_list")
		for j=0, count-1 do
			local _, id, _ = ini:r_line("anomalies_list", j, "", "")
			table.insert(anomaly_types, id)
		end
	end
	
	local air_allowed_list = {}
	if ini:section_exist("air_spawn_allowed") then
		local count = ini:line_count("air_spawn_allowed")
		for j=0, count-1 do
			local _, id, _ = ini:r_line("air_spawn_allowed", j, "", "")
			table.insert(air_allowed_list, id)
		end
	end

	if #anomaly_types == 0 then return end

	local smart_list = {}
	local count_smarts = ini:line_count(level_name)
	for j=0, count_smarts-1 do
		local _, id, _ = ini:r_line(level_name, j, "", "")
		table.insert(smart_list, id)
	end

	local board = sim_board.get_sim_board()
	if not board then return end

	for _, smart_name in pairs(smart_list) do
		local smart = board.smarts_by_names[smart_name]
		if smart then
			local count_anom = math.random(count_min, count_max)
			for i = 1, count_anom do
				local section = anomaly_types[math.random(#anomaly_types)]
				
				local final_radius = default_radius
				if string.find(section, "zone_field_") then
					final_radius = field_r_min + math.random() * (field_r_max - field_r_min)
				end
				
				local additional_height = 0
				for _, allowed_part in pairs(air_allowed_list) do
					if string.find(section, allowed_part) then
						additional_height = air_spawn_height
						break
					end
				end

				local pos = generate_position(smart, max_offset_x, max_offset_y, max_offset_z, max_tries, additional_height)
				
				if pos then
					local lv_id = level.vertex_id(pos)
					local gv_id = smart.m_game_vertex_id 
					local s_obj = create_anomaly(section, final_radius, pos, lv_id, gv_id)
					if s_obj then
						random_anomaly_id[s_obj.id] = s_obj.id
					end
				end
			end
		end
	end
end

-- === ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ДЛЯ АРТЕФАКТОВ ===

-- Чтение настроек (вызывается при спавне и удалении, чтобы подхватить изменения конфига без перезапуска игры)
function load_settings(ini_obj)
	local ini = ini_obj or ini_file("misc\\dynamic_anomaly.ltx")
	if ini:section_exist("settings") then
		enable_arts    = ini:r_bool("settings", "enable_artifact_spawn")
		chance_death   = ini:r_float("settings", "chance_spawn_on_death")
		chance_blowout = ini:r_float("settings", "chance_spawn_on_blowout")
	end
	
	-- Кэшируем группы артефактов
	art_groups_cache = {}
	if ini:section_exist("artifact_groups") then
		local count = ini:line_count("artifact_groups")
		for j=0, count-1 do
			local _, id, _ = ini:r_line("artifact_groups", j, "", "")
			table.insert(art_groups_cache, id)
		end
	end
end

-- Основная функция попытки спавна артефакта
function try_spawn_artifact(anomaly_se_obj)
	if not cached_ini then cached_ini = ini_file("misc\\dynamic_anomaly.ltx") end
	local ini = cached_ini
	local anom_sect = anomaly_se_obj:section_name()
	
	-- Ищем подходящую группу
	local found_group = nil
	for _, group in pairs(art_groups_cache) do
		-- Если имя аномалии содержит имя группы (например, zone_mine_gravitational_average содержит zone_mine_gravitational)
		if string.find(anom_sect, group) then
			found_group = group
			break
		end
	end
	
	if found_group and ini:section_exist(found_group) then
		-- Собираем список артефактов из этой группы
		local arts = {}
		local count = ini:line_count(found_group)
		for j=0, count-1 do
			local _, id, _ = ini:r_line(found_group, j, "", "")
			table.insert(arts, id)
		end
		
		if #arts > 0 then
			local art_section = arts[math.random(#arts)]
			local pos = anomaly_se_obj.position		
			local spawn_pos = vector():set(pos.x, pos.y + 2.0, pos.z)		
			
			-- Спавним артефакт в центре аномалии на высоте 2 метра (чтобы не проваливался)
			local art_se_obj = alife():create(art_section, spawn_pos, anomaly_se_obj.m_level_vertex_id, anomaly_se_obj.m_game_vertex_id)
			if art_se_obj then
				spawned_artifacts_id[art_se_obj.id] = true -- Сохраняем его ID, чтобы потом удалить!
			end
			--printf("DYNAMIC_ANOMALY: Spawned artifact %s from anomaly %s", art_section, anom_sect)
		end
	end
end

-- !!! ЭТУ ФУНКЦИЮ ВЫЗЫВАТЬ ИЗ BIND_STALKER и BIND_MONSTER !!!
function check_death_in_anomaly(victim_obj)
	if not enable_arts then return end
	if math.random() > chance_death then return end
	
	local victim_pos = victim_obj:position()
	
	-- Проверяем, находится ли жертва внутри одной из НАШИХ аномалий
	for k, id in pairs(random_anomaly_id) do
		-- Нам нужен клиентский объект аномалии, чтобы проверить inside()
		local anom_obj = level.object_by_id(id)
		
		if anom_obj then
			if anom_obj:inside(victim_pos) then
				-- Жертва внутри аномалии -> пробуем заспавнить арт
				local se_anom = alife():object(id)
				if se_anom then
					try_spawn_artifact(se_anom)
					-- Можно выйти после первого успеха, чтобы не спавнить 2 арта, если зоны пересекаются
					return 
				end
			end
		end
	end
end

-- === ОСТАЛЬНЫЕ ФУНКЦИИ (без изменений) ===

function generate_position(smart, max_x, max_y, max_z, tries, add_height_limit)
	local pos = vector():set(0,0,0)
	local valid = false
	
	while (tries > 0) and not valid do
		local offset_x = (max_x * math.random())
		if math.random() <= 0.5 then offset_x = -offset_x end
		
		local offset_y = (max_y * math.random())
		if math.random() <= 0.5 then offset_y = -offset_y end
		
		local offset_z = (max_z * math.random())
		if math.random() <= 0.5 then offset_z = -offset_z end
		
		local final_x = smart.position.x + offset_x
		local final_y = smart.position.y + offset_y
		local final_z = smart.position.z + offset_z
		
		pos = vector():set(final_x, final_y, final_z)
		
		local lvid = level.vertex_id(pos)
		if lvid < 4294967295 then
			pos = level.vertex_position(lvid)
			if add_height_limit and add_height_limit > 0 then
				local h = math.random() * add_height_limit
				pos.y = pos.y + h
			end
			valid = true
		end
		tries = tries - 1
	end
	if valid then return pos else return nil end
end

function save(packet)
	local cnt = 0
	for k,v in pairs(random_anomaly_id) do cnt = cnt + 1 end
	packet:w_u16(cnt)
	for k,v in pairs(random_anomaly_id) do packet:w_u32(k) end
	
	local cnt_arts = 0
	for k,v in pairs(spawned_artifacts_id) do cnt_arts = cnt_arts + 1 end
	packet:w_u16(cnt_arts)
	for k,v in pairs(spawned_artifacts_id) do packet:w_u32(k) end	
end

function load(reader)
	random_anomaly_id = {}
	spawned_artifacts_id = {}	
	
	local n = reader:r_u16()
	for i = 1,n do
		local k = reader:r_u32()
		random_anomaly_id[k] = k
	end
	
	local n_arts = reader:r_u16()
	for i = 1, n_arts do
		local k = reader:r_u32()
		spawned_artifacts_id[k] = true
	end
	
	-- При загрузке сразу подгружаем настройки, чтобы работала проверка смерти
	load_settings() 
end

function create_anomaly(zone_name, zone_radius, position, lv, gv)
	if gv==nil then gv=db.actor:game_vertex_id() end
	if lv==nil then lv=db.actor:level_vertex_id() end
	if position==nil then position=db.actor:position() end

	local sobj = alife():create(zone_name, position, lv, gv)

	local packet = net_packet()
	packet:w_begin(0)

	sobj:STATE_Write(packet)
	packet:r_seek(2)

	local game_vertex_id	=	packet:r_u16()
	local distance			=	packet:r_float()
	local direct_control	=	packet:r_s32()
	local level_vertex_id	=	packet:r_s32()
	local object_flags		=	packet:r_s32()
	local custom_data		=	packet:r_stringZ()
	local story_id			=	packet:r_s32()
	local spawn_story_id	=	packet:r_s32()
	local shape_count		=	packet:r_u8()
	for i = 1,shape_count do
		local shape_type = packet:r_u8()
		if shape_type == 0 then
			local center = packet:r_vec3()
			local radius = packet:r_float()
		else
			local box = packet:r_matrix()
		end
	end
	local restrictor_type				=	packet:r_u8()
	local max_power						=	packet:r_float()
	local owner_id						=	packet:r_s32()
	local enabled_time					=	packet:r_u32()
	local disabled_time					=	packet:r_u32()
	local start_time_shift				=	packet:r_u32()
	local offline_interactive_radius	=	packet:r_float()
	local artefact_spawn_count			=	packet:r_u16()
	local artefact_position_offset		=	packet:r_s32()
	local last_spawn_time				=	packet:r_u8()

	local new_center = vector():set(0, 0, 0)
	owner_id		=	bit_not(0)
	restrictor_type	= 3
	max_power = 0
	offline_interactive_radius	= 30
	artefact_spawn_count	= 32
	last_spawn_time = 0

	packet:w_begin(0)
	packet:w_u16(game_vertex_id)
	packet:w_float(distance)
	packet:w_s32(direct_control)
	packet:w_s32(level_vertex_id)
	packet:w_s32(object_flags)
	packet:w_stringZ(custom_data)
	packet:w_s32(story_id)
	packet:w_s32(spawn_story_id)
	packet:w_u8(1)
	packet:w_u8(0)
	packet:w_vec3(new_center)
	packet:w_float(zone_radius)
	packet:w_u8(restrictor_type)
	packet:w_float(max_power)
	packet:w_s32(owner_id)
	packet:w_u32(enabled_time)
	packet:w_u32(disabled_time)
	packet:w_u32(start_time_shift)
	packet:w_float(offline_interactive_radius)
	packet:w_u16(artefact_spawn_count)
	packet:w_s32(artefact_position_offset)
	packet:w_u8(last_spawn_time)

	packet:r_seek(2)
	sobj:STATE_Read(packet, packet:w_tell())
 	return sobj
end