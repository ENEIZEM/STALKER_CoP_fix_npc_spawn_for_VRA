local visuals_cache = {}

-- Отдельная функция проверки визуала
local function is_mouth_allowed_visuals(npc)
    -- Получаем имя визуала
    local visual = npc:get_visual_name()

    -- Если результат для этой модели еще не записан в кеш, вычисляем его
    if visuals_cache[visual] == nil then
        if string.find(visual, "face") or string.find(visual, "mask") then
            visuals_cache[visual] = true
        else
            visuals_cache[visual] = false
        end
    end

    return visuals_cache[visual]
end

--------------------------------------------------------------------------------
-- Predicate functions for xr_animpoint actions --------------------------------
--------------------------------------------------------------------------------

function const_predicate_true(npc_id)
    --local npc = db.storage[npc_id] and db.storage[npc_id].object
    --return npc and not db.storage[npc_id].need_sleep
	return true
end

function animpoint_predicate_bread(npc_id)
    local npc = db.storage[npc_id] and db.storage[npc_id].object
    return npc and is_mouth_allowed_visuals(npc) and npc:object("bread") and not db.storage[npc_id].need_sleep
end

function animpoint_predicate_kolbasa(npc_id)
    local npc = db.storage[npc_id] and db.storage[npc_id].object
    return npc and is_mouth_allowed_visuals(npc) and npc:object("kolbasa") and not db.storage[npc_id].need_sleep
end

function animpoint_predicate_vodka(npc_id)
    local npc = db.storage[npc_id] and db.storage[npc_id].object
    return npc and is_mouth_allowed_visuals(npc) and npc:object("vodka") and not db.storage[npc_id].need_sleep
end

function animpoint_predicate_energy(npc_id)
    local npc = db.storage[npc_id] and db.storage[npc_id].object
    return npc and is_mouth_allowed_visuals(npc) and npc:object("energy_drink") and not db.storage[npc_id].need_sleep
end

function animpoint_predicate_guitar(npc_id, is_in_camp)
    local npc = db.storage[npc_id] and db.storage[npc_id].object
    return npc and is_in_camp and npc:object("guitar_a") and not db.storage[npc_id].need_sleep
end

function animpoint_predicate_guitar_2(npc_id, is_in_camp)
    local npc = db.storage[npc_id] and db.storage[npc_id].object
    return npc and is_in_camp and npc:object("guitar_a2") and not db.storage[npc_id].need_sleep
end

function animpoint_predicate_harmonica(npc_id, is_in_camp)
    local npc = db.storage[npc_id] and db.storage[npc_id].object
    return npc and is_in_camp and is_mouth_allowed_visuals(npc) and npc:object("harmonica_a") and not db.storage[npc_id].need_sleep
end

function animpoint_predicate_weapon(npc_id)
	local npc = db.storage[npc_id] and db.storage[npc_id].object

	if npc and not db.storage[npc_id].need_sleep then
		local community = npc:character_community()
		local allowed_communities = {
			bandit = true,
			freedom = true,
			killer = true,		
		}
		return allowed_communities[community] == true
	end
	return false
end

function animpoint_predicate_need_sleep(npc_id)
	local npc = db.storage[npc_id] and db.storage[npc_id].object
	
	if (npc and not db.storage[npc_id].need_sleep and (level.get_time_hours() < 5 or level.get_time_hours() > 20)) then
		if (db.storage[npc_id].check_sleep and time_global() < db.storage[npc_id].check_sleep) then
			return db.storage[npc_id].need_sleep == true
		end

		-- Проверяет каждый игровой час
		db.storage[npc_id].check_sleep = time_global() + 36000

		-- 70% шанс на сон
		if (math.random(100) > 30) then
			db.storage[npc_id].need_sleep = true
			return true
		end

		db.storage[npc_id].need_sleep = false
	end
	return false
end

function animpoint_predicate_use_pda_sit_ass(npc_id)
    local npc = db.storage[npc_id] and db.storage[npc_id].object
    return npc and db.storage[npc_id].object:object("pda_for_nps_sit_ass") and not db.storage[npc_id].need_sleep
end

function animpoint_predicate_use_pda_sit_normal(npc_id)
    local npc = db.storage[npc_id] and db.storage[npc_id].object
    return npc and db.storage[npc_id].object:object("pda_for_nps_sit_normal") and not db.storage[npc_id].need_sleep
end

