-- Has

function actor_has_money_1500(first_speaker, second_speaker)
	return db.actor:money() >= 1500
end

function actor_has_money_3500(first_speaker, second_speaker)
	return db.actor:money() >= 3500
end

function actor_has_money_5000(first_speaker, second_speaker)
	return db.actor:money() >= 5000
end

-- Hasnt

function actor_hasnt_money_3500(first_speaker, second_speaker)
	return db.actor:money() < 3500
end

function actor_hasnt_money_5000(first_speaker, second_speaker)
	return db.actor:money() < 5000
end

-- Sell

function actor_sell_money_1500(first_speaker, second_speaker)
	dialogs.relocate_money_from_actor(first_speaker, second_speaker, 1500)
end

function actor_sell_money_3500(first_speaker, second_speaker)
	dialogs.relocate_money_from_actor(first_speaker, second_speaker, 3500)
end

function actor_sell_money_5000(first_speaker, second_speaker)
	dialogs.relocate_money_from_actor(first_speaker, second_speaker, 5000)
end

-- Take

function actor_take_money_1500(first_speaker, second_speaker)
	dialogs.relocate_money_to_actor(first_speaker, second_speaker, 1500)
end

-- Receives

-- …бать, когда вы уже сделаете так чтобы можно было передавать параметры в xml

function actor_has_money(first_speaker, second_speaker, amount)
    return db.actor:money() >= tonumber(amount)
end

function actor_hasnt_money(first_speaker, second_speaker, amount)
    return db.actor:money() >= tonumber(amount)
end

function actor_sell_money(first_speaker, second_speaker, amount)
    local money = tonumber(amount)
    dialogs.relocate_money_from_actor(first_speaker, second_speaker, money)
end

function actor_receives_money(first_speaker, second_speaker, amount)
    local money = tonumber(amount)
    dialogs.relocate_money_to_actor(first_speaker, second_speaker, money)
end