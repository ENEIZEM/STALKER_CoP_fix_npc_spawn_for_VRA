function jup_b1_actor_have_good_suit(first_speaker, second_speaker)
    local suit_true = false
    local outfit_true = false
    local helm_true = false	  
	
    -- Проверяем костюм в слоте 7
    local suit = db.actor:item_in_slot(7)
    if suit ~= nil then
        local suit_section = suit:section()
        -- Проверяем содержит ли секция нужные подстроки
        if string.find(suit_section, "scientific_outfit") or string.find(suit_section, "ecolog_outfit") or string.find(suit_section, "exo_outfit") then
            suit_true = true
        end
        if string.find(suit_section, "heavy_outfit") or string.find(suit_section, "military_outfit") or string.find(suit_section, "specops_outfit") 
		 or string.find(suit_section, "stalker_outfit") or string.find(suit_section, "light_outfit") then
            outfit_true = true
        end		
    end	
	
    -- Проверяем шлем в слоте 12
    local helmet = db.actor:item_in_slot(12)
    if helmet ~= nil then
        local helmet_section = helmet:section()
        if string.find(helmet_section, "helm_tactic") or string.find(helmet_section, "helm_battle") then
            helm_true = true
        end
    end
    
	if suit_true or (outfit_true and helm_true) then
		return true
	else
		return false	
	end
end

function jup_b1_actor_do_not_have_good_suit(first_speaker, second_speaker)
	return not jup_b1_actor_have_good_suit(first_speaker, second_speaker)
end

