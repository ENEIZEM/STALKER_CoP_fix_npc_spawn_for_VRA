-- Jupiter a10

local THREAT_COST = 10000 

function jup_bandit_vano_debt_leader_actor_weapon(first_speaker, second_speaker)
	local actor = db.actor
	local ini = system_ini()

	-- Проверяем 2-й и 3-й (автоматы/снайперки) слоты
	for _, slot in ipairs({2, 3}) do
		local item = actor:item_in_slot(slot)
		if item then
			local sec = item:section()
			if ini:section_exist(sec) and ini:line_exist(sec, "cost") then
				local cls = ini:r_string(sec, "class")
				
				-- Проверяем, что это огнестрел (класс начинается на WP_), и отсеиваем бинокль/нож
				if string.find(cls, "WP_") and cls ~= "WP_BINOC" and cls ~= "WP_KNIFE" then
					local cost = ini:r_u32(sec, "cost")
					
					-- Если базовая цена ствола больше или равна нашему порогу угрозы — возвращаем true
					if cost >= THREAT_COST then
						return true
					end
				end
			end
		end
	end

	return false
end

function jup_bandit_vano_debt_leader_actor_silly_weapon(first_speaker, second_speaker)
	return not jup_bandit_vano_debt_leader_actor_weapon(first_speaker, second_speaker)
end

