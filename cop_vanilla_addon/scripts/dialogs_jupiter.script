function jup_b47_jupiter_another_docs_enabled(first_speaker, second_speaker)
    -- Если есть основной документ, не показываем эту ветку
    if db.actor:object("jup_b47_jupiter_products_info") ~= nil then
        return false
    end
    
    local items_table = {
        --"jup_a9_conservation_info",
        --"jup_a9_power_info", 
        --"jup_a9_way_info",
        "jup_a9_evacuation_info",
        "jup_a9_meeting_info",
        "jup_a9_losses_info",
        "jup_a9_delivery_info"
    }
    
    for k,v in pairs(items_table) do
        if db.actor:object(v) ~= nil then
            return true
        end
    end
    
    return false
end

function jup_b47_jupiter_another_docs_sell(first_speaker, second_speaker)
    local npc = dialogs.who_is_npc(first_speaker, second_speaker)
    local items_table = {
        --"jup_a9_conservation_info", -- Всё равно отдаёт Азоту
        --"jup_a9_power_info", 
        --"jup_a9_way_info",
        "jup_a9_evacuation_info",
        "jup_a9_meeting_info",
        "jup_a9_losses_info",
        "jup_a9_delivery_info"
    }
    
    local docs_given = 0
    
    for k,v in pairs(items_table) do
        if db.actor:object(v) ~= nil then
            dialogs.relocate_item_section(npc, v, "out")
            
            -- Даём деньги только если документ ещё не сдавали
            if not has_alife_info("jup_b47_doc_sold_"..v) then
                dialogs.relocate_money_to_actor(first_speaker, second_speaker, 500)
                db.actor:give_info_portion("jup_b47_doc_sold_"..v)
            end
            
            docs_given = docs_given + 1
        end
    end
    
    -- Бонус за все документы (проверяем по инфопорциям)
    if docs_given >= 4 and not has_alife_info("jup_b47_all_docs_bonus_given") then
        dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "detector_elite")
		dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "medkit_scientic")
		dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "medkit_scientic")
		dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "medkit_scientic")
		dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "medkit_scientic")		
        db.actor:give_info_portion("jup_b47_all_docs_bonus_given")
    end
end

