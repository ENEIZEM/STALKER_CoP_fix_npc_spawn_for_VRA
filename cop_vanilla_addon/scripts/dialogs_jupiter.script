function jup_b9_actor_has_money(first_speaker, second_speaker)
	return db.actor:money() >= get_blackbox_current_cost()
end

function jup_b9_actor_has_not_money(first_speaker, second_speaker)
	return not jup_b9_actor_has_money(first_speaker, second_speaker)
end

function jupiter_b9_relocate_money(first_speaker, second_speaker)
	dialogs.relocate_money_from_actor(first_speaker, second_speaker, get_blackbox_current_cost())
end

function jup_b217_tech_blackbox_cost_text(first_speaker, second_speaker)
	local cost = get_blackbox_current_cost()
	local count = 0
	for i = 1, 9 do
		if has_alife_info("jup_b200_tech_materials_brought_counter_" .. i) then
			count = i
		end
	end

	local template_id = "jup_b217_stalker_tech_blackbox_start_1210"
	if count >= 9 then
		template_id = "jup_b217_stalker_tech_blackbox_start_1219"
	elseif count >= 6 then
		template_id = "jup_b217_stalker_tech_blackbox_start_1216"
	elseif count >= 1 then
		template_id = "jup_b217_stalker_tech_blackbox_start_1211"
	end

	return string.format(game.translate_string(template_id), cost)
end

