--------------------------------------------------------------------------------
-- ECONOMY: GUIDE GARRY, BLACK BOX DECRYPTION, UFO MEMORY MODULE
--------------------------------------------------------------------------------
local GARRY_COST_PRIPYAT         = 8000  -- Jupiter -> Pripyat
local GARRY_COST_ZATON_REGULAR   = 5000  -- Pripyat -> Zaton (no maps)
local GARRY_COST_ZATON_DISCOUNT  = 3000  -- Pripyat -> Zaton (with maps)

local NITRO_UFO_COST             = 4500  -- Nitro memory module unlock cost
local NOVIKOV_UFO_COST           = 4500  -- Novikov memory module unlock cost

-- Black box decryption costs based on radio material counter (0 to 9)
local blackbox_cost_table = {
	[0] = 10000,
	[1] = 9500,
	[2] = 9000,
	[3] = 8500,
	[4] = 8000,
	[5] = 7500,
	[6] = 7000,
	[7] = 6500,
	[8] = 6000,
	[9] = 5000
}

local function get_blackbox_current_cost()
	local cost = blackbox_cost_table[0]
	for i = 1, 9 do
		if has_alife_info("jup_b200_tech_materials_brought_counter_" .. i) then
			cost = blackbox_cost_table[i]
		end
	end
	return cost
end

--------------------------------------------------------------------------------
-- 1. GUIDE GARRY (JUP_B43)
--------------------------------------------------------------------------------
function pay_cost_to_guide_to_pripyat(first_speaker, second_speaker)
	dialogs.relocate_money_from_actor(first_speaker, second_speaker, GARRY_COST_PRIPYAT)
end

function jup_b43_actor_has_money_pripyat(first_speaker, second_speaker)
	return db.actor:money() >= GARRY_COST_PRIPYAT
end

function jup_b43_actor_has_no_money_pripyat(first_speaker, second_speaker)
	return db.actor:money() < GARRY_COST_PRIPYAT
end

function pay_cost_to_guide_to_zaton(first_speaker, second_speaker)
	local cost = has_alife_info("zat_b215_gave_maps") and GARRY_COST_ZATON_DISCOUNT or GARRY_COST_ZATON_REGULAR
	dialogs.relocate_money_from_actor(first_speaker, second_speaker, cost)
end

function jup_b43_actor_has_money_zaton(first_speaker, second_speaker)
	local cost = has_alife_info("zat_b215_gave_maps") and GARRY_COST_ZATON_DISCOUNT or GARRY_COST_ZATON_REGULAR
	return db.actor:money() >= cost
end

function jup_b43_actor_has_no_money_zaton(first_speaker, second_speaker)
	return not jup_b43_actor_has_money_zaton(first_speaker, second_speaker)
end

