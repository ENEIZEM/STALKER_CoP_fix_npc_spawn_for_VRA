function jup_b15_actor_sci_outfit(first_speaker, second_speaker)
    local found_scientific = false
	 
    local function check_item(npc, item)
        local section = item:section()
        if not found_scientific and (string.find(section, "scientific_outfit") or string.find(section, "ecolog_outfit")) then
            found_scientific = true
        end				
    end
    
    db.actor:iterate_inventory(check_item, nil)
	
	if found_scientific then
		return true
	else
		return false
    end
end

function jup_b15_no_actor_sci_outfit(first_speaker, second_speaker)
    local found_scientific = false
	 
    local function check_item(npc, item)
        local section = item:section()
        if string.find(section, "scientific_outfit") or string.find(section, "ecolog_outfit") then
            found_scientific = true
        end	
    end
    
    db.actor:iterate_inventory(check_item, nil)
	
	if not found_scientific then
		return true
	else
		return false
    end
end

