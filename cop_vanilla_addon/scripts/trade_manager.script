local trade_manager = {}

-- =========================================================================
-- ДЕФОЛТНЫЕ НАСТРОЙКИ (применяются, если не указаны в [trader])
-- =========================================================================
local DEF_RESUPPLY_INTERVAL       = 48    -- в часах (48 часов = 2 дня)
local DEF_DYNAMIC_UPDATE_INTERVAL = 1     -- в часах (1 час)
local DEF_MIN_CHANGES             = 1
local DEF_MAX_CHANGES             = 5
local DEF_CHANCE_BUY_OUT          = 70
local DEF_CHANCE_BRING_NEW        = 30
local DEF_CHANCE_DAMAGED          = 50
local DEF_MIN_CONDITION           = 0.5   -- скриптовый дефолт для минимума
local DEF_MAX_CONDITION           = 0.99  -- скриптовый дефолт для максимума
-- =========================================================================

-- Универсальный парсер строки "min, max" или одного числа "val"
local function parse_range(str_val, def_min, def_max)
	if str_val == nil or str_val == "" then
		return def_min, (def_max or def_min)
	end
	local nums = {}
	for part in string.gmatch(str_val, "[^,]+") do
		local n = tonumber(string.match(part, "%s*([%d%.]+)%s*"))
		if n ~= nil then
			table.insert(nums, n)
		end
	end
	if #nums == 0 then
		return def_min, (def_max or def_min)
	elseif #nums == 1 then
		return nums[1], nums[1]
	else
		return math.min(nums[1], nums[2]), math.max(nums[1], nums[2])
	end
end

-- Вспомогательная функция броска кубика для задержки
local function roll_delay(min_sec, max_sec)
	if min_sec >= max_sec then
		return min_sec
	end
	return math.random(min_sec, max_sec)
end

local function is_condition_item(section)
	local ini = system_ini()
	return ini:line_exist(section, "condition_shot_dec")
		or ini:line_exist(section, "burn_protection")
		or ini:line_exist(section, "helmet_condition")
end

local function is_quest_item(section)
	return utils.cfg_get_bool(system_ini(), section, "quest_item", nil, false, false)
end

local function is_equipped(npc, item)
	for slot = 1, 12 do
		local slot_item = npc:item_in_slot(slot)
		if slot_item and slot_item:id() == item:id() then
			return true
		end
	end
	return false
end

local function dynamic_inventory_update(npc, tt)
	local consumables = {}
	local equipment_sections = {}

	local function scan_item(npc, item)
		local sec = item:section()
		if not is_equipped(npc, item) and not is_quest_item(sec) then
			if is_condition_item(sec) then
				equipment_sections[sec] = true
			else
				if consumables[sec] == nil then
					consumables[sec] = {}
				end
				table.insert(consumables[sec], item)
			end
		end
	end

	npc:iterate_inventory(scan_item, npc)

	-- =====================================================================
	-- ВЫЧИСЛЕНИЕ ГРАНИЦ ИЗНОСА
	-- =====================================================================
	local factor = tt.current_buy_item_condition_factor
	local min_cond = factor or tt.min_condition or DEF_MIN_CONDITION
	local max_cond = tt.max_condition or DEF_MAX_CONDITION

	if max_cond > 0.99 then
		max_cond = 0.99
	end

	if factor ~= nil and factor >= 1.0 then
		min_cond = 1.0
	elseif factor ~= nil then
		-- Защита от дурака: если max_condition поставили ниже buy_item_condition_factor
		if max_cond < factor then
			local diff_to_one = 1.0 - factor
			max_cond = factor + (diff_to_one * 0.25)
			if max_cond > 0.99 then
				max_cond = 0.99
			end
		end
	end

	local allow_damaged = (min_cond < 1.0) and (min_cond < max_cond) and (tt.chance_damaged > 0)
	-- =====================================================================

	local changes_count = math.random(tt.min_changes, tt.max_changes)

	local consumable_sec_list = {}
	for sec, _ in pairs(consumables) do
		table.insert(consumable_sec_list, sec)
	end

	local equip_sec_list = {}
	for sec, _ in pairs(equipment_sections) do
		table.insert(equip_sec_list, sec)
	end

	for i = 1, changes_count do
		local roll = math.random(1, 100)

		-- 1. Сталкеры купили расходник (-1 шт.)
		if roll <= tt.chance_buy_out and #consumable_sec_list > 0 then
			local rand_sec = consumable_sec_list[math.random(#consumable_sec_list)]
			local items = consumables[rand_sec]
			if items and #items > 1 then
				local item_to_remove = table.remove(items)
				local se_obj = alife():object(item_to_remove:id())
				if se_obj then
					alife():release(se_obj, true)
				end
			end

		-- 2. Сталкеры сдали б/у ствол или броню с износом
		elseif allow_damaged and roll <= (tt.chance_buy_out + tt.chance_damaged) and #equip_sec_list > 0 then
			local rand_equip_sec = equip_sec_list[math.random(#equip_sec_list)]
			local se_obj = alife():create(rand_equip_sec, npc:position(), npc:level_vertex_id(), npc:game_vertex_id(), npc:id())
			if se_obj then
				local min_c = math.ceil(min_cond * 100)
				local max_c = math.floor(max_cond * 100)
				if min_c >= max_c then
					min_c = max_c - 1
				end

				local rand_cond = math.random(min_c, max_c) / 100
				tt.pending_condition[se_obj.id] = rand_cond
			end

		-- 3. Сталкеры сдали обычный расходник (+1 шт.)
		elseif #consumable_sec_list > 0 then
			local rand_sec = consumable_sec_list[math.random(#consumable_sec_list)]
			alife():create(rand_sec, npc:position(), npc:level_vertex_id(), npc:game_vertex_id(), npc:id())
		end
	end
end

-- =========================================================================
-- БАЗОВЫЕ ФУНКЦИИ
-- =========================================================================

function trade_init(npc, cfg)
	if trade_manager[npc:id()] == nil then
		trade_manager[npc:id()] = {}
	end

	local tt = trade_manager[npc:id()]
	tt.cfg_ltx = cfg
	tt.config = ini_file(cfg)
	tt.pending_condition = tt.pending_condition or {}

	-- Флаги принудительного применения при старте
	tt.buy_condition_applied = false
	tt.sell_condition_applied = false
	tt.buy_item_condition_factor_applied = false

	local str = utils.cfg_get_string(tt.config, "trader", "buy_condition", npc, true, "")
	if str == nil then
		abort("Incorrect trader settings. Cannot find buy_condition. [%s]->[%s]", npc:name(), cfg)
	end
	tt.buy_condition = xr_logic.parse_condlist(npc, "trade_manager", "buy_condition", str)

	str = utils.cfg_get_string(tt.config, "trader", "sell_condition", npc, true, "")
	if str == nil then
		abort("Incorrect trader settings. Cannot find sell_condition. [%s]->[%s]", npc:name(), cfg)
	end
	tt.sell_condition = xr_logic.parse_condlist(npc, "trade_manager", "sell_condition", str)

	str = utils.cfg_get_string(tt.config, "trader", "buy_supplies", npc, false, "")
	if str ~= nil then
		tt.buy_supplies = xr_logic.parse_condlist(npc, "trade_manager", "buy_supplies", str)
	end

	str = utils.cfg_get_string(tt.config, "trader", "buy_item_condition_factor", npc, false, "", "0.7")
	if str ~= nil then
		tt.buy_item_condition_factor = xr_logic.parse_condlist(npc, "trade_manager", "buy_item_condition_factor", str)
	end

	-- 1. resupply_interval: парсинг диапазона в часах (например "36, 48" или "48")
	local resup_str = utils.cfg_get_string(tt.config, "trader", "resupply_interval", npc, false, "")
	local r_min, r_max = parse_range(resup_str, DEF_RESUPPLY_INTERVAL, DEF_RESUPPLY_INTERVAL)
	tt.resupply_min_sec = math.floor(r_min * 3600)
	tt.resupply_max_sec = math.floor(r_max * 3600)

	-- 2. dynamic_update_interval: парсинг диапазона в часах (например "0, 1" или "1, 2")
	local dyn_str = utils.cfg_get_string(tt.config, "trader", "dynamic_update_interval", npc, false, "")
	local d_min, d_max = parse_range(dyn_str, DEF_DYNAMIC_UPDATE_INTERVAL, DEF_DYNAMIC_UPDATE_INTERVAL)
	-- Минимум 60 секунд (1 игровая минута), чтобы при 0 не грузило процессор
	tt.dynamic_min_sec = math.max(math.floor(d_min * 3600), 60)
	tt.dynamic_max_sec = math.max(math.floor(d_max * 3600), tt.dynamic_min_sec)

	-- 3. changes: парсинг одной строчкой "1, 5" либо старыми min_changes / max_changes
	local changes_str = utils.cfg_get_string(tt.config, "trader", "changes", npc, false, "")
	if changes_str ~= "" then
		tt.min_changes, tt.max_changes = parse_range(changes_str, DEF_MIN_CHANGES, DEF_MAX_CHANGES)
	else
		tt.min_changes = utils.cfg_get_number(tt.config, "trader", "min_changes", npc, false, DEF_MIN_CHANGES)
		tt.max_changes = utils.cfg_get_number(tt.config, "trader", "max_changes", npc, false, DEF_MAX_CHANGES)
	end

	tt.chance_buy_out   = utils.cfg_get_number(tt.config, "trader", "chance_buy_out", npc, false, DEF_CHANCE_BUY_OUT)
	tt.chance_bring_new = utils.cfg_get_number(tt.config, "trader", "chance_bring_new", npc, false, DEF_CHANCE_BRING_NEW)
	tt.chance_damaged   = utils.cfg_get_number(tt.config, "trader", "chance_damaged", npc, false, DEF_CHANCE_DAMAGED)
	tt.min_condition    = utils.cfg_get_number(tt.config, "trader", "min_condition", npc, false, nil)
	tt.max_condition    = utils.cfg_get_number(tt.config, "trader", "max_condition", npc, false, DEF_MAX_CONDITION)
end

function update(npc)
	local tt = trade_manager[npc:id()]
	if tt == nil then return end

	-- Выставляем износ б/у вещам при переходе в онлайн
	if tt.pending_condition then
		for id, cond in pairs(tt.pending_condition) do
			local obj = level.object_by_id(id)
			if obj then
				obj:set_condition(cond)
				tt.pending_condition[id] = nil
			end
		end
	end

	local cur_global_time = time_global()
	if tt.update_time ~= nil and tt.update_time > cur_global_time then
		return
	end
	tt.update_time = cur_global_time + 1000

	local str = xr_logic.pick_section_from_condlist(db.actor, npc, tt.buy_condition)
	-- ИСПРАВЛЕНО: форсируем применение при первом апдейте или если сменилась секция
	if str and (tt.current_buy_condition ~= str or not tt.buy_condition_applied) then
		npc:buy_condition(tt.config, str)
		tt.current_buy_condition = str
		tt.buy_condition_applied = true
	end

	str = xr_logic.pick_section_from_condlist(db.actor, npc, tt.sell_condition)
	-- ИСПРАВЛЕНО: форсируем применение при первом апдейте или если сменилась секция
	if str and (tt.current_sell_condition ~= str or not tt.sell_condition_applied) then
		npc:sell_condition(tt.config, str)
		tt.current_sell_condition = str
		tt.sell_condition_applied = true
	end

	if tt.buy_item_condition_factor then
		local factor = tonumber(xr_logic.pick_section_from_condlist(db.actor, npc, tt.buy_item_condition_factor))
		-- ИСПРАВЛЕНО: форсируем применение при первом апдейте или если сменился фактор
		if factor and (tt.current_buy_item_condition_factor ~= factor or not tt.buy_item_condition_factor_applied) then
			npc:buy_item_condition_factor(factor)
			tt.current_buy_item_condition_factor = factor
			tt.buy_item_condition_factor_applied = true
		end
	end

	if tt.buy_supplies == nil then return end

	str = xr_logic.pick_section_from_condlist(db.actor, npc, tt.buy_supplies)
	if str == "" or str == nil then return end

	local cur_game_time = game.get_game_time()

	-- Инициализация рандомной задержки для глобального завоза
	if tt.next_resupply_delay == nil then
		tt.next_resupply_delay = roll_delay(tt.resupply_min_sec, tt.resupply_max_sec)
	end

	-- Глобальный завоз
	local need_resupply = false
	if tt.current_buy_supplies ~= str then
		need_resupply = true
	elseif tt.resuply_time == nil then
		need_resupply = true
	elseif cur_game_time:diffSec(tt.resuply_time) >= tt.next_resupply_delay then
		need_resupply = true
	end

	if need_resupply then
		npc:buy_supplies(tt.config, str)
		tt.current_buy_supplies = str
		tt.resuply_time = cur_game_time
		tt.last_dynamic_update = cur_game_time
		-- Рассчитываем следующее случайное время завоза
		tt.next_resupply_delay = roll_delay(tt.resupply_min_sec, tt.resupply_max_sec)
		return
	end

	-- Микро-изменения ассортимента
	if not npc:is_talking() then
		if tt.next_dynamic_delay == nil then
			tt.next_dynamic_delay = roll_delay(tt.dynamic_min_sec, tt.dynamic_max_sec)
		end

		if tt.last_dynamic_update == nil then
			tt.last_dynamic_update = cur_game_time
			tt.next_dynamic_delay = roll_delay(tt.dynamic_min_sec, tt.dynamic_max_sec)
		elseif cur_game_time:diffSec(tt.last_dynamic_update) >= tt.next_dynamic_delay then
			dynamic_inventory_update(npc, tt)
			tt.last_dynamic_update = cur_game_time
			-- Рассчитываем следующую задержку микро-завоза
			tt.next_dynamic_delay = roll_delay(tt.dynamic_min_sec, tt.dynamic_max_sec)
		end
	end
end

function save(obj, packet)
	local tt = trade_manager[obj:id()]
	set_save_marker(packet, "save", false, "trade_manager")

	if tt == nil then
		packet:w_bool(false)
		set_save_marker(packet, "save", true, "trade_manager")
		return
	else
		packet:w_bool(true)
	end

	packet:w_stringZ(tt.cfg_ltx)
	packet:w_stringZ(tt.current_buy_condition or "")
	packet:w_stringZ(tt.current_sell_condition or "")
	packet:w_stringZ(tt.current_buy_supplies or "")

	utils.w_CTime(packet, tt.resuply_time)
	utils.w_CTime(packet, tt.last_dynamic_update)

	-- Сохраняем текущие рандомные задержки (в секундах)
	packet:w_u32(tt.next_resupply_delay or 0)
	packet:w_u32(tt.next_dynamic_delay or 0)

	set_save_marker(packet, "save", true, "trade_manager")
end

function load(obj, packet)
	set_save_marker(packet, "load", false, "trade_manager")

	local a = packet:r_bool()
	if a == false then
		set_save_marker(packet, "load", true, "trade_manager")
		return
	end

	trade_manager[obj:id()] = {}
	local tt = trade_manager[obj:id()]
	tt.pending_condition = {}

	-- Сбрасываем флаги принудительного применения при загрузке сейва
	tt.buy_condition_applied = false
	tt.sell_condition_applied = false
	tt.buy_item_condition_factor_applied = false

	tt.cfg_ltx = packet:r_stringZ()
	tt.config = ini_file(tt.cfg_ltx)

	a = packet:r_stringZ()
	printf("TRADE LOAD [%s]: current_buy_condition = %s", obj:name(), tostring(a))
	if a ~= "" then
		tt.current_buy_condition = a
		-- Мы НЕ вызываем тут buy_condition, так как движок его проигнорирует.
		-- Скрипт безопасно применит его на первом тике функции update()!
	end

	a = packet:r_stringZ()
	printf("TRADE LOAD [%s]: current_sell_condition = %s", obj:name(), tostring(a))
	if a ~= "" then
		tt.current_sell_condition = a
		-- То же самое, применим на первом апдейте
	end

	a = packet:r_stringZ()
	printf("TRADE LOAD [%s]: current_buy_supplies = %s", obj:name(), tostring(a))
	if a ~= "" then
		tt.current_buy_supplies = a
	end

	tt.resuply_time = utils.r_CTime(packet)
	tt.last_dynamic_update = utils.r_CTime(packet)

	local next_resup = packet:r_u32()
	if next_resup > 0 then
		tt.next_resupply_delay = next_resup
	end

	local next_dyn = packet:r_u32()
	if next_dyn > 0 then
		tt.next_dynamic_delay = next_dyn
	end

	set_save_marker(packet, "load", true, "trade_manager")
end

function get_buy_discount(npc_id)
	local tt = trade_manager[npc_id]
	if tt == nil or tt.config == nil then return 1 end
	local str = utils.cfg_get_string(tt.config, "trader", "discounts", nil, false, "", "")
	if str == "" then return 1 end
	local sect = xr_logic.pick_section_from_condlist(db.actor, nil, xr_logic.parse_condlist(nil, "trade_manager", "discounts", str))
	return utils.cfg_get_number(tt.config, sect, "buy", nil, false, 1)
end

function get_sell_discount(npc_id)
	local tt = trade_manager[npc_id]
	if tt == nil or tt.config == nil then return 1 end
	local str = utils.cfg_get_string(tt.config, "trader", "discounts", nil, false, "", "")
	if str == "" then return 1 end
	local sect = xr_logic.pick_section_from_condlist(db.actor, nil, xr_logic.parse_condlist(nil, "trade_manager", "discounts", str))
	return utils.cfg_get_number(tt.config, sect, "sell", nil, false, 1)
end