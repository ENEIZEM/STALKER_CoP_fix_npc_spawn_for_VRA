-- ====================================================================================

-- Èíèöèàëèçèğóåì êîíôèã ñğàçó â íà÷àëå ôàéëà
local orders_ini = ini_file("misc\\nimble_orders.ltx")

local function get_config()
    return orders_ini
end

-- Ñ÷èòàåì êîëè÷åñòâî êàòåãîğèé
local function get_categories_count()
    local ini = get_config()
    local count = 0
    while ini:section_exist("category_" .. tostring(count + 1)) do
        count = count + 1
    end
    return count
end

-- Ïîëó÷àåì ñïèñîê ïğåäìåòîâ â êîíêğåòíîì çàêàçå êàòåãîğèè
local function get_order_items(cat_idx, item_idx)
    local ini = get_config()
    local sec = "category_" .. tostring(cat_idx)
    local line = "order_" .. tostring(item_idx)

    if not ini:line_exist(sec, line) then 
        return {} 
    end

    local raw = ini:r_string(sec, line)
    local items = {}
    for item in string.gmatch(raw, "[%w_%-%.]+") do
        table.insert(items, item)
    end
    return items
end

-- Ñ÷èòàåì êîëè÷åñòâî äîñòóïíûõ çàêàçîâ â êàòåãîğèè
local function get_category_orders_count(cat_idx)
    local ini = get_config()
    local sec = "category_" .. tostring(cat_idx)
    if not ini:section_exist(sec) then return 0 end

    local count = 0
    while ini:line_exist(sec, "order_" .. tostring(count + 1)) do
        count = count + 1
    end
    return count
end

-- Áàçîâàÿ öåíà ñåêöèè (åñëè åñòü ğîäèòåëü áåç _nimble — áåğåì åãî)
local function get_base_cost(sec)
    local ini = system_ini()
    local parent_sec = sec:gsub("_nimble", "")
    
    if ini:section_exist(parent_sec) and ini:line_exist(parent_sec, "cost") then
        return ini:r_u32(parent_sec, "cost")
    elseif ini:section_exist(sec) and ini:line_exist(sec, "cost") then
        return ini:r_u32(sec, "cost")
    end
    return 1000
end

-- Îïğåäåëÿåì, êàêàÿ êàòåãîğèÿ è ïğåäìåò ñåé÷àñ àêòèâíû
function get_active_order()
    for cat_idx = 1, get_categories_count() do
        if has_alife_info("zat_b51_processing_category_" .. cat_idx) then
            local count = get_category_orders_count(cat_idx)
            for item_idx = 1, count do
                if has_alife_info("zat_b51_ordered_item_" .. cat_idx .. "_" .. item_idx) then
                    return cat_idx, item_idx
                end
            end
            return cat_idx, nil
        end
    end
    return nil, nil
end

-- Ğàñ÷¸ò ôèíàíñîâ
function get_order_financials()
    local cat_idx, item_idx = get_active_order()
    if not cat_idx then return 0, 0, 0 end

    local ini = get_config()

    -- Åñëè ïğåäìåò åùå íå âûïàë ğàíäîìîì — âûáèğàåì åãî
    if not item_idx then
        local available = {}
        local count = get_category_orders_count(cat_idx)
        for j = 1, count do
            if not has_alife_info("zat_b51_done_item_" .. cat_idx .. "_" .. j) then
                table.insert(available, j)
            end
        end
        item_idx = #available > 0 and available[math.random(1, #available)] or 1
        db.actor:give_info_portion("zat_b51_ordered_item_" .. cat_idx .. "_" .. item_idx)
    end

    local items = get_order_items(cat_idx, item_idx)
    local base_cost = 0
    for _, sec in ipairs(items) do
        base_cost = base_cost + get_base_cost(sec)
    end

    local markup = ini:r_float("nimble_economy", "markup")
    local total_cost = math.floor(base_cost * markup)

    local is_refused = has_alife_info("zat_b51_order_refused")
    local prepay_rate = is_refused and ini:r_float("nimble_economy", "prepay_refused") 
                                   or  ini:r_float("nimble_economy", "prepay_norm")

    local prepay = math.floor(total_cost * prepay_rate)
    local remainder = total_cost - prepay

    return total_cost, prepay, remainder
end

-- -----------------------------------------------------------------------------------
-- ÄÈÀËÎÃÎÂÛÅ ÔÓÍÊÖÈÈ
-- -----------------------------------------------------------------------------------

function zat_b51_randomize_item(first_speaker, second_speaker)
    get_order_financials()
end

function zat_b51_give_prepay(first_speaker, second_speaker)
    local _, prepay, _ = get_order_financials()
    if prepay > 0 then
        dialogs.relocate_money_from_actor(first_speaker, second_speaker, prepay)
    end
    start_delivery_timer()
end

function zat_b51_has_prepay(first_speaker, second_speaker)
    local _, prepay, _ = get_order_financials()
    return db.actor:money() >= prepay
end

function zat_b51_hasnt_prepay(first_speaker, second_speaker)
    return not zat_b51_has_prepay(first_speaker, second_speaker)
end

function zat_b51_has_item_cost(first_speaker, second_speaker)
    local _, _, remainder = get_order_financials()
    return db.actor:money() >= remainder
end

function zat_b51_hasnt_item_cost(first_speaker, second_speaker)
    return not zat_b51_has_item_cost(first_speaker, second_speaker)
end

function zat_b51_buy_item(first_speaker, second_speaker)
    local cat_idx, item_idx = get_active_order()
    if not cat_idx or not item_idx then return end

    local _, _, remainder = get_order_financials()
    local items = get_order_items(cat_idx, item_idx)

    -- Âûäàåì ÂÑÅ ïğåäìåòû (áğîíş + øëåì)
    for _, sec in ipairs(items) do
        dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, sec)
    end
    dialogs.relocate_money_from_actor(first_speaker, second_speaker, remainder)

    disable_info("zat_b51_processing_category_" .. cat_idx)
    disable_info("zat_b51_ordered_item_" .. cat_idx .. "_" .. item_idx)
    give_info("zat_b51_done_item_" .. cat_idx .. "_" .. item_idx)

    if has_alife_info("zat_b51_order_refused") then
        if has_alife_info("zat_b51_forgiven_step_1") then
            disable_info("zat_b51_order_refused")
            disable_info("zat_b51_forgiven_step_1")
        else
            give_info("zat_b51_forgiven_step_1")
        end
    end

    local count = get_category_orders_count(cat_idx)
    local category_finishing = true
    for j = 1, count do
        if not has_alife_info("zat_b51_done_item_" .. cat_idx .. "_" .. j) then
            category_finishing = false
            break
        end
    end
    if category_finishing then
        give_info("zat_b51_finishing_category_" .. cat_idx)
    end
end

function zat_b51_refuse_item(first_speaker, second_speaker)
    local cat_idx, item_idx = get_active_order()
    if not cat_idx or not item_idx then return end

    disable_info("zat_b51_processing_category_" .. cat_idx)
    disable_info("zat_b51_ordered_item_" .. cat_idx .. "_" .. item_idx)
    give_info("zat_b51_done_item_" .. cat_idx .. "_" .. item_idx)

    if has_alife_info("zat_b51_forgiven_step_1") then
        disable_info("zat_b51_forgiven_step_1")
    end

    local count = get_category_orders_count(cat_idx)
    local category_finishing = true
    for j = 1, count do
        if not has_alife_info("zat_b51_done_item_" .. cat_idx .. "_" .. j) then
            category_finishing = false
            break
        end
    end
    if category_finishing then
        give_info("zat_b51_finishing_category_" .. cat_idx)
    end
end

function zat_b51_clear_category_infos()
    for i = 1, get_categories_count() do
        disable_info("zat_b51_processing_category_" .. i)
    end
end

-- -----------------------------------------------------------------------------------
-- ÒÅÊÑÒÛ ÄÈÀËÎÃÎÂ
-- -----------------------------------------------------------------------------------

function nimble_prepay_text(actor, npc, dialog_id, phrase_id)
    local cat_idx, _ = get_active_order()
    if not cat_idx then return "" end

    local ini = get_config()
    local total_cost, prepay, _ = get_order_financials()
    local cat_name_id = ini:r_string("category_" .. tostring(cat_idx), "name")
    local cat_name = game.translate_string(cat_name_id)

    local template = has_alife_info("zat_b51_order_refused")
                     and "st_nimble_prepay_refused_template"
                     or  "st_nimble_prepay_template"

    return string.format(game.translate_string(template), cat_name, total_cost, prepay)
end

function nimble_final_pay_text(actor, npc, dialog_id, phrase_id)
    local cat_idx, item_idx = get_active_order()
    if not cat_idx or not item_idx then return "" end

    local _, _, remainder = get_order_financials()
    local items = get_order_items(cat_idx, item_idx)
    local sys_ini = system_ini()

    local names = {}
    for _, sec in ipairs(items) do
        if sys_ini:section_exist(sec) and sys_ini:line_exist(sec, "inv_name") then
            table.insert(names, game.translate_string(sys_ini:r_string(sec, "inv_name")))
        end
    end

    local final_name = table.concat(names, " è ")
    return string.format(game.translate_string("st_nimble_final_pay_template"), final_name, remainder)
end

-- =============================================================================
-- ÒÀÉÌÅĞ ÄÎÑÒÀÂÊÈ ÇÀÊÀÇÀ
-- =============================================================================

function start_delivery_timer()
    local cat_idx, _ = get_active_order()
    if not cat_idx then return end

    local ini = get_config()
    local wait_hours = ini:r_u32("category_" .. tostring(cat_idx), "time")

    -- Ñ÷èòàåì òåêóùåå èãğîâîå âğåìÿ â ìèíóòàõ
    local now_minutes = level.get_time_days() * 1440 
                      + level.get_time_hours() * 60 
                      + level.get_time_minutes()

    local ready_minutes = now_minutes + (wait_hours * 60)
    
    -- Ñîõğàíÿåì â pstor (ïåğåæèâàåò ñåéâ/ëîàä)
    xr_logic.pstor_store(db.actor, "zat_b51_order_ready_time", ready_minutes)
end

-- Ôóíêöèÿ-ïğåêîíäèøí äëÿ ëîãèêè ğåñòğèêòîğà
function is_order_ready()
    local ready_minutes = xr_logic.pstor_retrieve(db.actor, "zat_b51_order_ready_time", 0)
    if ready_minutes == 0 then 
        return true 
    end

    local now_minutes = level.get_time_days() * 1440 
                      + level.get_time_hours() * 60 
                      + level.get_time_minutes()

    return now_minutes >= ready_minutes
end