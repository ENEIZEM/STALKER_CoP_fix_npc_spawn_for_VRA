-- basic dynamic msg_box
-- alundaio

local ini = ini_file("sr_teleport_sections.ltx")

local SINGLETON = nil

function create(obj,disable_msg,item)
	SINGLETON = SINGLETON or msg_box_ui(obj,disable_msg,item)
	SINGLETON:Reset(obj,disable_msg,item)
	return SINGLETON
end

local old_pos

function on_update()
	if not (SINGLETON) then
		return true 
	end
	
	if (old_pos) then
		if (old_pos:similar(db.actor:position(),1.2) == 0) then
			SINGLETON:OnMsgCancel()
			return true
		end
	end
	
	return false
end

------------------------------------------------------------------------------------
class "msg_box_ui" (CUIScriptWnd)
function msg_box_ui:__init(obj,disable_msg,item) super()
	self:SetWndRect(Frect():set(0,0,1024,768))
	self:SetAutoDelete(true)
	
	self.message_box = CUIMessageBoxEx()
	self:Register(self.message_box, "msg_box")

	self:InitCallBacks()
	self:InitControls(obj,disable_msg,item)
end

function msg_box_ui:__finalize()
	SINGLETON = nil
end

function msg_box_ui:Reset(obj,disable_msg,item)
	if (self.message_box and self.message_box:IsShown()) then 
		self.message_box:HideDialog()
	end
	self:InitControls(obj,disable_msg,item)
end

function msg_box_ui:InitCallBacks()
	self:AddCallback("msg_box",     ui_events.MESSAGE_BOX_OK_CLICKED,			self.OnMsgOk,						self)
	self:AddCallback("msg_box",     ui_events.MESSAGE_BOX_CANCEL_CLICKED,		self.OnMsgCancel,					self)
	self:AddCallback("msg_box",     ui_events.MESSAGE_BOX_YES_CLICKED,			self.OnMsgOk,						self)
	self:AddCallback("msg_box",     ui_events.MESSAGE_BOX_NO_CLICKED,			self.OnMsgCancel,					self)
end

function msg_box_ui:OnMsgOk()
	-- ПРОВЕРЯЕМ ЧТО position ИЛИ path СУЩЕСТВУЕТ
	local pos = ini:line_exist(self.name,"position") and ini:r_string(self.name,"position")
	local path = ini:line_exist(self.name,"path") and ini:r_string(self.name,"path")
	local point = path and patrol(path)

	if not (pos or point) then
		printf("sr_teleport_sections.ltx: no position or path in section %s", self.name)
		return
	end

	if not (self.disable_msg) then
		level.add_pp_effector("black.ppe", 1313, false)
	end
	
	if (ini:r_bool(self.name,"autosave",false)) then
		local hint_text = ini:line_exist(self.name,"hint") and ini:r_string(self.name,"hint") or "moving"
		xr_effects.scenario_autosave(nil,nil,{hint_text})
	end
	
	-- Простое чтение координат без split
	local x, y, z, dir
	if pos then
		x, y, z, dir = string.match(pos, "([^,]+),([^,]+),([^,]+),?([^,]*)")
		pos = vector():set(tonumber(x), tonumber(y), tonumber(z))
	end

	db.actor:set_actor_position(pos or point and point:point(0))

	if dir and dir ~= "" then
		db.actor:set_actor_direction(tonumber(dir) or 0)
	end
end

function msg_box_ui:OnMsgCancel()
	if (self.message_box and self.message_box:IsShown()) then 
		self.message_box:HideDialog()
	end
	
	-- ДОБАВИЛ ПРОВЕРКУ line_exist
	local pos = ini:line_exist(self.name,"reject") and ini:r_string(self.name,"reject")
	local path = ini:line_exist(self.name,"reject_path") and ini:r_string(self.name,"reject_path")
	local point = path and patrol(path)

	if not (pos or point) then
		return
	end

	-- Простое чтение координат для reject
	local x, y, z, dir
	if pos then
		x, y, z, dir = string.match(pos, "([^,]+),([^,]+),([^,]+),?([^,]*)")
		pos = vector():set(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0)
	end

	db.actor:set_actor_position(pos or point and point:point(0) or db.actor:position())
	if dir and dir ~= "" then
		db.actor:set_actor_direction(tonumber(dir) or 0)
		return
	end
	db.actor:set_actor_direction(-device().cam_dir:getH())
end

function msg_box_ui:InitControls(obj,disable_msg,item)
	self.obj = obj
	self.name = obj and obj:name()
	self.disable_msg = disable_msg
	self.item = item

	if (string.find(self.name,obj:id())) then
		local story_name = get_object_story_id(obj:id())
		self.name = story_name or self.name
	end

	if (not self.name or not ini:section_exist(self.name)) then
		printf("sr_teleport_sections.ltx: section doesn't exist %s",obj and obj:name())
		return
	end

	local enable_string = ini:line_exist(self.name,"enable") and ini:r_string(self.name,"enable")
	
	if (enable_string) then
		local enable_condlist = xr_logic.parse_condlist(db.actor, self.name, "enable", enable_string)
		local enable = xr_logic.pick_section_from_condlist(db.actor,obj,enable_condlist)
		
		if (enable == "false") then 
			local reject_on_disable = false
			
		if ini:line_exist(self.name, "reject_on_disabled") then
			local reject_string = ini:r_string(self.name, "reject_on_disabled")
			
			if (reject_string == "true" or reject_string == "false") then
				-- Старый булевый формат для совместимости
				reject_on_disable = (reject_string == "true")
			else
				-- Новый кондлист формат
				local reject_condlist = xr_logic.parse_condlist(db.actor, self.name, "reject_on_disabled", reject_string)
				local reject_result = xr_logic.pick_section_from_condlist(db.actor, obj, reject_condlist)
				reject_on_disable = (reject_result == "true")
			end
		end
		
		if (reject_on_disable) then
			self:OnMsgCancel()
		end		
			return
		end
	end
	
	if (self.disable_msg) then
		if (not self.item or db.actor:object(self.item)) then
			self:OnMsgOk()
		else
			self:OnMsgCancel()
		end
		return
	end

	self.message_box:InitMessageBox("message_box_yes_no")
	self.message_box:ShowDialog(true)
	local str = game.translate_string(ini:r_string(self.name,"text") or "")
	self.message_box:SetText(str)
	
	old_pos = db.actor:position()
end