---------------------------------------------------------------------------------------------
--' Made by Distemper, Fixed by Gemini (Corpses + Weapons Hybrid) ---------------------------
--' Updated: Fix Weapon Detection (Server Object Support)
--' Вносит уникальные story_id трупы если игрок приблизился к оному на расстояние менее 3х метров. 
--' Поддерживает оружие и выброшенные игроком предметы. Нужна доп регистрация в коллбэках on_item_take и on_item_drop, а также update.
---------------------------------------------------------------------------------------------

-- Настройки
local IDLE_AFTER_DEATH = 300000 		-- 5 минут (время жизни на текущем уровне)
local MAX_CAPACITY = 20      			-- Лимит объектов на ТЕКУЩЕЙ локации
local MIN_DIST_TO_RELEASE_SQR = 5000 	-- 100 метров
local UNLOCK_DIST_SQR = 4 -- въебать 9 если будут удаляться              -- 2 метра в квадрате (для снятия story_id)

-- Настройки сканера
local WEAPON_SCAN_INTERVAL = 10000      -- Сканировать раз в 10 сек

-- Кэш для проверки, является ли секция оружием (чтобы не читать конфиг 1000 раз)
local is_weapon_cache = {}

-- Вспомогательные функции
local function get_object_level_id(obj_game_vertex_id)
	return game_graph():vertex(obj_game_vertex_id):level_id()
end

-- Читаем класс из конфига. Если класс начинается на "WP_", значит это оружие.
local function is_weapon_section(section)
	if is_weapon_cache[section] ~= nil then
		return is_weapon_cache[section]
	end

	local sys_ini = system_ini()
	if sys_ini:section_exist(section) and sys_ini:line_exist(section, "class") then
		local class_name = sys_ini:r_string(section, "class")
		-- WP_AK74, WP_LR300, WP_BM16 и т.д. Все они содержат "WP_"
		-- Бинокль (WP_BINOC) и Нож (WP_KNIFE) тоже попадут сюда.
		if string.find(class_name, "WP_") then
			is_weapon_cache[section] = true
			return true
		end
	end
	
	is_weapon_cache[section] = false
	return false
end

local RB_manager = nil

class "Crelease_body"

function Crelease_body:__init()
	self.release_objects_table = {}
	self.keep_items_table = {} 
 	self.body_max_count = MAX_CAPACITY
	self.last_weapon_scan_time = 0 

	-- Кэшируем исключения (квестовые предметы из death_generic)
	local snd_ini = ini_file("misc\\death_generic.ltx")
	if snd_ini:section_exist("keep_items") then
		local n = snd_ini:line_count("keep_items")
		for i = 0, n - 1 do
			local _, section, _  = snd_ini:r_line("keep_items", i, "", "")
			self.keep_items_table[section] = true 
		end
	end
end

function Crelease_body:add_to_table(id)
	-- Проверка на дубликаты
	for _, v in pairs(self.release_objects_table) do
		if v.id == id then return end
	end

	local obj_params = {}
	obj_params.id = id
	obj_params.death_time = time_global()
	
	if get_object_story_id(id) ~= nil then
		obj_params.story_locked = true
	else
		obj_params.story_locked = false
	end
	
	table.insert(self.release_objects_table, obj_params)
end

-- Добавление трупов (вызывается из биндера)
function Crelease_body:moving_dead_body(obj)
	if self:inspection_result(obj) then
		self:add_to_table(obj:id())
		self:perform_cleanup_step()
	end
end

-- Функция для обработки предметов, выброшенных ИГРОКОМ
function Crelease_body:add_player_drop(obj)
	if not obj then return end

	local section = obj:section()
	--if self.keep_items_table[section] then 
		--return 
	--end

	if get_object_story_id(obj:id()) ~= nil then
		return 
	end

    local name = obj:name()
    local id = obj:id()
    
    -- Если имя уникальное (не совпадает с шаблоном), выходим
    if name ~= section .. tostring(id) then 
        return 
    end

	self:add_to_table(obj:id())
	
	self:perform_cleanup_step()
end

-- Сканирование бесхозного оружия
function Crelease_body:scan_for_weapons()
	local tg = time_global()
	if tg < self.last_weapon_scan_time + WEAPON_SCAN_INTERVAL then
		return
	end
	self.last_weapon_scan_time = tg

	local forbidden_ids = {}
	if treasure_manager then
		forbidden_ids = treasure_manager.get_treasure_manager().items_from_secrets or {}
	end

	local sim = alife()
	-- Проход по всем объектам ALife
	for i=1, 65534 do
		local obj = sim:object(i)
		-- parent_id 65535 = лежит на земле (никому не принадлежит)
		if obj and obj.parent_id == 65535 then 
			local section = obj:section_name()
			
			-- Используем новую проверку по секции
			if is_weapon_section(section) then
				if not forbidden_ids[obj.id] then				
					if not self.keep_items_table[section] then
						local name = obj:name()
						local id = obj.id -- Важно! У серверного объекта id это поле, без скобок ()
            
						-- Если имя стандартное - добавляем. Если уникальное - игнорируем.
						if name == section .. tostring(id) then
							self:add_to_table(obj.id)
						end					
					end
				end
			end
		end
	end
	
	self:perform_cleanup_step()
end

function Crelease_body:update()
	self:scan_for_weapons()
	self:perform_cleanup_step()
end

-- Функция очистки
function Crelease_body:perform_cleanup_step()
	local actor = db.actor
	if not actor then return end
	
	local sim = alife()
	local actor_level_id = get_object_level_id(actor:game_vertex_id())
	local actor_pos = actor:position()

	for i = #self.release_objects_table, 1, -1 do
		local entry = self.release_objects_table[i]
		local obj = sim:object(entry.id)

		if not obj then
			table.remove(self.release_objects_table, i)
		else
			local obj_level_id = get_object_level_id(obj.m_game_vertex_id)
			local is_on_same_level = (obj_level_id == actor_level_id)

			-- 1. Снятие story_id защиты при приближении
			if entry.story_locked and is_on_same_level then
				local dist_sqr = actor_pos:distance_to_sqr(obj.position)
				if dist_sqr <= UNLOCK_DIST_SQR then
					entry.story_locked = false
				end
			end

			-- 2. Удаление объектов с ДРУГОЙ локации (если не залочены)
			if not is_on_same_level and not entry.story_locked then
				if obj.parent_id == 65535 then
					sim:release(obj, true)
				end
				table.remove(self.release_objects_table, i)
			end
		end
	end

	-- 3. Удаление лишнего на ТЕКУЩЕЙ локации
	if #self.release_objects_table > self.body_max_count then
		self:try_to_release()
	end
end

-- Поиск кандидата на удаление (самый дальний + старый)
local function find_candidate_to_release(release_tbl)
	local actor = db.actor
	if not actor then return nil end

	local actor_pos = actor:position()
	local tg = time_global()

	local best_dist_sqr = MIN_DIST_TO_RELEASE_SQR
	local candidate_idx = nil

	for k, v in pairs(release_tbl) do
		local obj = alife():object(v.id)

		if not obj then
			return k 
		end

		if not v.story_locked then
			local dist_sqr = actor_pos:distance_to_sqr(obj.position)
			local time_passed = v.death_time and (tg > v.death_time + IDLE_AFTER_DEATH)
			
			if dist_sqr > best_dist_sqr and time_passed then
				best_dist_sqr = dist_sqr
				candidate_idx = k
			end
		end
	end

	return candidate_idx
end

function Crelease_body:try_to_release()
	while #self.release_objects_table > self.body_max_count do
		local idx = find_candidate_to_release(self.release_objects_table)
		
		if idx == nil then return end 

		local item = self.release_objects_table[idx]
		local release_object = alife():object(item.id)

		if release_object then
			-- Финальная проверка перед удалением
			-- Удаляем только если объект НИКОМУ не принадлежит (parent_id 65535)
			-- ИЛИ если это труп (IsStalker/IsMonster)
			local is_item_free = (release_object.parent_id == 65535)
			local is_corpse = (IsStalker(release_object) or IsMonster(release_object))

			if is_item_free or is_corpse then
				alife():release(release_object, true)
			end
		end

		table.remove(self.release_objects_table, idx)
	end
end

-- Проверки для трупов (инвентарь, квесты)
function Crelease_body:inspection_result(obj)
	for section, _ in pairs(self.keep_items_table) do
		if obj:object(section) ~= nil then return false end
	end
	if self:check_for_known_info(obj) then return false end
	return true
end

function Crelease_body:check_for_known_info(obj)
	local spawn_ini = obj:spawn_ini()
	local filename = nil
	if spawn_ini then
		filename = utils.cfg_get_string(spawn_ini, "logic", "cfg", obj, false, "")
	end
	local char_ini
	if filename then
		if not getFS():exist("$game_config$", filename) then return false end
		char_ini = ini_file(filename)
	else
		char_ini = obj:spawn_ini() or ini_file("scripts\\dummy.ltx")
	end
	local st = db.storage[obj:id()]
	if not st or not st.section_logic then return false end
	local known_info = utils.cfg_get_string(char_ini, st.section_logic, "known_info", obj, false, "", nil) or "known_info"
	return char_ini:section_exist(known_info)
end

function Crelease_body:remove_from_table(id)
	for i, v in pairs(self.release_objects_table) do
		if v.id == id then
			table.remove(self.release_objects_table, i)
			return -- Нашли и удалили, выходим
		end
	end
end

function Crelease_body:save(packet)
	set_save_marker(packet, "save", false, "Crelease_body")
	local count = #self.release_objects_table
	packet:w_u16(count)
	for _,v in pairs(self.release_objects_table) do
		packet:w_u16(v.id)
		packet:w_bool(v.story_locked) 
	end
	set_save_marker(packet, "save", true, "Crelease_body")
end

function Crelease_body:load(reader)
	set_save_marker(reader, "load", false, "Crelease_body")
	local count = reader:r_u16()
	self.release_objects_table = {}
	local current_time = time_global()
	for i = 1, count do
		local vid = reader:r_u16()
		self.release_objects_table[i] = {}
		self.release_objects_table[i].id = vid
		self.release_objects_table[i].story_locked = reader:r_bool()
		self.release_objects_table[i].death_time = current_time
	end
	set_save_marker(reader, "load", true, "Crelease_body")
end

function get_release_body_manager()
	if(RB_manager==nil) then
		RB_manager = Crelease_body()
	end
	return RB_manager
end