----------------------------------------------------------------------------------------------------
-- Таймер с выводом изображения на экран (В секундах + Сохранение + Пауза)
----------------------------------------------------------------------------------------------------

local k,v = 0,0

class "action_timer"
function action_timer:__init(obj, storage)
	self.object = obj
	self.st = storage
end

function action_timer:update(delta)
	local actor = db.actor
	if xr_logic.try_switch_to_another_section(self.object, self.st, actor) then
		return
	end
	
	-- Инициализация переменных времени при старте или после загрузки
	if self.st.elapsed == nil then
		self.st.elapsed = xr_logic.pstor_retrieve(self.object, "timer_" .. self.st.timer_sec_name, 0)
	end
	if self.st.last_time == nil then
		self.st.last_time = time_global()
	end

	-- Высчитываем сколько мс прошло с прошлого кадра (защита от сброса time_global при сейв/лоаде)
	local dt = time_global() - self.st.last_time
	self.st.last_time = time_global()

	-- Проверка на паузу
	local paused = (xr_logic.pick_section_from_condlist(db.actor, self.object, self.st.pause_cond) == "true")
	
	if not paused then
		self.st.elapsed = self.st.elapsed + dt
	end

	-- Изменяем значение счетчика
	local value_time = 0
	if self.st.type == "inc" then
		value_time = self.st.start_value + self.st.elapsed
	else
		value_time = self.st.start_value - self.st.elapsed
	end
	
	if value_time <= 0 then
		value_time = 0
	end

	-- Формируем строку счетчика
	local hours = math.floor(value_time/3600000)
	local minutes = math.floor(value_time/60000 - hours*60)
	local seconds = math.floor(value_time/1000 - hours*3600 - minutes*60)
	local str = tostring(hours)..":"..time2str(minutes)..":"..time2str(seconds)

	self.st.timer:TextControl():SetTextST(str)

	-- Определяем нужно ли куда то переходить
	for k,v in pairs(self.st.on_value) do
		if (self.st.type == "dec" and value_time <= v.dist) or
			 (self.st.type == "inc" and value_time >= v.dist)
		then
			-- Очищаем память, чтобы при повторном заходе в эту же секцию таймер стартовал с нуля
			xr_logic.pstor_store(self.object, "timer_" .. self.st.timer_sec_name, 0)
			xr_logic.switch_to_section(self.object, self.st.ini, xr_logic.pick_section_from_condlist(db.actor, self.object, v.state))
		end
	end
end

function action_timer:deactivate(delta)
	self.st.ui:RemoveCustomStatic(self.st.timer_id)
	if self.st.string ~= nil then
		self.st.ui:RemoveCustomStatic("hud_timer_text")
	end
	-- Сбрасываем сохраненное время при выходе из схемы (чтоб не залипало)
	xr_logic.pstor_store(self.object, "timer_" .. self.st.timer_sec_name, 0)
end

function action_timer:save()
	-- Сохраняем текущее прошедшее время в сейв
	xr_logic.pstor_store(self.object, "timer_" .. self.st.timer_sec_name, self.st.elapsed or 0)
end

function time2str(n)
	if n >= 10 then
		return tostring(n)
	else
		return "0"..tostring(n)
	end
end
---------------------------------------------------------------------------------------------------------------------
function add_to_binder(obj, ini, scheme, section, storage)
	local action = action_timer(obj, storage)
	xr_logic.subscribe_action_for_events(obj, storage, action)
end

function set_scheme(obj, ini, scheme, section, gulag_name)
	local st = xr_logic.assign_storage_and_bind(obj, ini, scheme, section)
	st.logic = xr_logic.cfg_get_switch_conditions(ini, section, obj)
	st.type = utils.cfg_get_string( ini, section, "type", obj, false, "", "inc")
	st.timer_sec_name = section -- Сохраняем имя секции для уникального ID в сохранениях
	
	if st.type ~= "inc" and st.type ~= "dec" then
		abort("ERROR: wrong sr_timer type. Section [%s], Restrictor [%s]", section, obj:name())
	end

	-- УМНОЖАЕМ НА 1000, чтобы в конфиге писать секунды, а не миллисекунды!
	if st.type == "dec" then
		st.start_value = utils.cfg_get_number(ini, section, "start_value", obj, true) * 1000
	else
		st.start_value = utils.cfg_get_number(ini, section, "start_value", obj, false, 0) * 1000
	end
	
	-- Читаем условие для паузы
	local pause_str = utils.cfg_get_string(ini, section, "timer_pause", obj, false, "", "false")
	st.pause_cond = xr_logic.parse_condlist(obj, "timer", "timer_pause", pause_str)
	
	-- Вычитываем значения перехода.
	st.on_value = parse_data(obj, utils.cfg_get_string(ini, section, "on_value", obj, false, ""))
	st.timer_id = utils.cfg_get_string( ini, section, "timer_id", obj, false, "", "hud_timer")
	st.string	= utils.cfg_get_string( ini, section, "string", obj, false, "")

	st.ui = get_hud()
	st.ui:AddCustomStatic(st.timer_id, true)
	st.timer = st.ui:GetCustomStatic(st.timer_id):wnd()

	if st.string ~= nil then
		st.ui:AddCustomStatic("hud_timer_text", true)
		local timer_text = st.ui:GetCustomStatic("hud_timer_text"):wnd()
		timer_text:TextControl():SetTextST(st.string)
	end
end

function parse_data(npc,s)
	local t = {}

	if s then
		for name in string.gfind( s, "(%|*%d+%|[^%|]+)%p*" ) do
			local dat = {	dist = nil,
							state = nil}

			local t_pos = string.find( name, "|", 1, true )

			local dist = string.sub( name, 1, t_pos - 1 )
			local state	= string.sub( name, t_pos + 1)

			-- УМНОЖАЕМ дистанцию перехода на 1000, чтобы on_value тоже использовать в секундах!
			dat.dist = tonumber(dist) * 1000
			if state then
				dat.state = xr_logic.parse_condlist(npc, dist, state, state)
			end
			table.insert(t, dat)
		end
	end
	return t
end