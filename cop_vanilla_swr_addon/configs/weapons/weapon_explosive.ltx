;-------------------------------------------------------------------------------
; Fuel Can (Balon)
;-------------------------------------------------------------------------------
[explosive_fuelcan]:identity_immunities,delayed_action_fuse,default_weapon_params,explosive_fuelcan_sounds
GroupControlSection         = spawn_group
discovery_dependency        = 
$spawn                      = "weapons\explosive\fuelcan"
$prefetch                   = 16
class                       = S_EXPLO
cform                       = skeleton
visual                      = dynamics\balon\balon_01.ogf

inv_name                    = 
inv_name_short              = 
cost                        = 50
inv_weight                  = 0.1
can_take                    = false                 ; item cannot be picked up

inv_grid_width              = 1
inv_grid_height             = 1
inv_grid_x                  = 9
inv_grid_y                  = 9

blast                       = 1.50
blast_r                     = 8
blast_impulse               = 250
blast_impulse_factor        = 1                     ; delete
hit_type_blast              = explosion
up_throw_factor             = 1.0

frags                       = 5
frags_r                     = 15
frag_hit                    = 0.75
frag_hit_impulse            = 150
hit_type_frag               = light_burn
fragment_speed              = 100                   ; fragment velocity (m/s)

wm_size                     = 0.1
wallmark_section            = explosion_marks
explode_particles           = explosions\explosion_fuelcan
explode_duration            = 5                     ; explosion duration (sec)

light_color                 = 1.9,1.3,0.5
light_range                 = 30.0
light_time                  = 1.5

;snd_explode                 = weapons\f1_explode    ; sounds
immunities_sect             = explosive_fuelcan_immunities_sect


[explosive_fuelcan_immunities_sect]
; hit immunity coefficients for various damage types
burn_immunity               = 0.0
strike_immunity             = 1.0
shock_immunity              = 1.0
wound_immunity              = 1.0
radiation_immunity          = 1.0
telepatic_immunity          = 1.0
chemical_burn_immunity      = 1.0
explosion_immunity          = 1.0
fire_wound_immunity         = 0.7


[explosive_gaz_balon]:explosive_fuelcan
$spawn                      = "weapons\explosive\gaz_balon"
