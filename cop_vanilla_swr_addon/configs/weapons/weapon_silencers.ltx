;-----------------------------------------------------------------------------
; Silencers (Base)
;-----------------------------------------------------------------------------

[wpn_addon_silencer]:identity_immunities
GroupControlSection         = spawn_group
discovery_dependency        = 
$spawn                      = "weapons\addons\silencer"
class                       = WP_SILEN
cform                       = skeleton
visual                      = dynamics\weapons\wpn_upgrade\wpn_silencer.ogf
$prefetch                   = 32
slot                        = -1

inv_name                    = st_addon_silencer_broken
inv_name_short              = st_addon_silencer_broken
description                 = st_addon_silencer_broken_descr
cost                        = 1000
inv_weight                  = 0.450

icons_texture               = ui\ui_icon_equipment_swr.dds
inv_grid_width              = 1
inv_grid_height             = 1
inv_grid_x                  = 18
inv_grid_y                  = 1

; Реалистичные базовые ТТХ: урон не режется, кучность чуть растет, отдача падает
bullet_hit_power_k          = 1.0
bullet_hit_impulse_k        = 1.0
bullet_speed_k              = 1.01
fire_dispersion_base_k      = 0.9
cam_dispersion_k            = 0.8
cam_dispersion_inc_k        = 0.85

